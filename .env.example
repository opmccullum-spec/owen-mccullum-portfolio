# Copy this file to `.env` and fill in real values from your Supabase
# project's Settings -> API page. `.env` itself is gitignored.

# Safe to expose in the browser (protected by Row Level Security).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-only. Bypasses all security rules. Never prefix this
# with PUBLIC_, never send it to the browser, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode to start: sk_test_...). Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=

# From Dashboard -> Developers -> Webhooks, after registering the endpoint.
STRIPE_WEBHOOK_SECRET=

# Documenso (Settings -> API tokens).
DOCUMENSO_API_KEY=

# The template ID of Owen's contract template (visible in its Documenso dashboard URL).
DOCUMENSO_TEMPLATE_ID=

# From setting up a webhook (event: document.completed) pointing at /api/webhooks/documenso.
DOCUMENSO_WEBHOOK_SECRET=

# Google Calendar (Google Cloud Console -> APIs & Services -> Credentials).
# GOOGLE_REFRESH_TOKEN comes from running scripts/get-google-refresh-token.mjs
# once, after creating the OAuth client below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Which calendar to read/write. Leave unset to use Owen's primary calendar.
GOOGLE_CALENDAR_ID=

# Resend (resend.com -> API Keys). Requires a verified sending domain to
# email anyone other than the Resend account's own signup address.
RESEND_API_KEY=

# The "from" address used for every outgoing email, e.g.
# "Owen McCullum Photography <bookings@owenmcc.photo>".
EMAIL_FROM=

# Owen's own inbox — gets pinged on a new booking request, a client
# cancelling, an invoice being paid, and a contract being signed.
OWNER_EMAIL=
