---
import { Image } from "astro:assets";
import lqip from "../data/lqip.json";
import bridgeGlow from "../assets/photos/bridge-glow.jpg";
import stiltPerformer from "../assets/photos/stilt-performer.jpg";
import flagsAtTheCourt from "../assets/photos/flags-at-the-court.jpg";
import kiteFestival from "../assets/photos/kite-festival.jpg";
import parkBenchRally from "../assets/photos/park-bench-rally.jpg";
import trumpMustGo from "../assets/photos/trump-must-go.jpg";
import rodeoCrowd from "../assets/photos/rodeo-crowd.jpg";
import flyoverWatchers from "../assets/photos/flyover-watchers.jpg";
import underTheArches from "../assets/photos/under-the-arches.jpg";
import winterRally from "../assets/photos/winter-rally.jpg";
import wornOut from "../assets/photos/worn-out.jpg";
import theShadowLine from "../assets/photos/the-shadow-line.jpg";
import steadyGaze from "../assets/photos/steady-gaze.jpg";

const lqipMap = lqip as Record<string, string>;

// A horizontal filmstrip the visitor scrolls through. Each frame magnet-snaps
// to the center of the screen; the centered frame is full size and opaque,
// while its neighbours shrink and fade. Whole images are shown, so any aspect
// ratio (landscape or portrait) sits comfortably side by side.
const frames = [
  { img: bridgeGlow, file: "bridge-glow.jpg", alt: "A woman in a crocheted top, sheer lace skirt, and cowboy boots leans against a bridge railing at dusk, string-lit buildings glowing warm behind her as a car's headlights pass below." },
  { img: stiltPerformer, file: "stilt-performer.jpg", alt: "A performer on stilts in an iridescent winged costume and a feathered crown twirls beneath a disco ball, colorful stage lights radiating behind her." },
  { img: flagsAtTheCourt, file: "flags-at-the-court.jpg", alt: "A bearded man in a wide-brim hat and leather work gloves holds an American flag outside the Supreme Court, protest flags and signs waving around him." },
  { img: kiteFestival, file: "kite-festival.jpg", alt: "A woman photographs kites overhead with her phone at the base of the Washington Monument, an eagle-shaped kite trailing ribbon streamers above the crowd." },
  { img: parkBenchRally, file: "park-bench-rally.jpg", alt: "Two women in patriotic red, white, and blue sit on a park bench at a rally, one in a walking boot, a crowd in flag-themed clothing gathered behind the fence." },
  { img: trumpMustGo, file: "trump-must-go.jpg", alt: "A dense crowd holds a wall of protest signs and an orange banner in the street, a government building with a large portrait banner rising behind them." },
  { img: rodeoCrowd, file: "rodeo-crowd.jpg", alt: "A crowd in patriotic dress shields their eyes and holds up phones beneath a 'Rodeo 250' banner, a leopard-print umbrella open against the sun." },
  { img: flyoverWatchers, file: "flyover-watchers.jpg", alt: "Silhouetted spectators crane their necks to photograph a jet flying over on a hazy afternoon, one pointing skyward beside a stone monument wall." },
  { img: underTheArches, file: "under-the-arches.jpg", alt: "A crowd rests and scrolls their phones on marble steps beneath an ornately tiled colonnade, a red-haired teenager standing out above the seated group." },
  { img: winterRally, file: "winter-rally.jpg", alt: "A man in a beanie and orange bandana speaks into a microphone at a snow-covered rally, the Washington Monument rising pale behind him as others huddle in winter coats." },
  { img: wornOut, file: "worn-out.jpg", alt: "Four people in dark uniforms sit slumped on a marble bench in the sun, one lying face-down reading a folded paper, another pulling a hood over their eyes." },
  { img: theShadowLine, file: "the-shadow-line.jpg", alt: "A boy in a white shirt and pink shorts stands at the sharp edge of sun and shadow beside the Washington Monument, a smaller child and the distant Capitol dome visible past the flags." },
  { img: steadyGaze, file: "steady-gaze.jpg", alt: "A close studio portrait of a man with braided hair resting his head against his raised hand, dramatic low light against a dark background." },
];
---

<section class="hero">
  {
    frames.length > 0 && (
      <>
        <div class="hero-strip" role="list" tabindex="0" aria-label="Featured photographs — scroll to advance">
          {
            frames.map((f, i) => (
              <figure
                class={`hero-frame${i === 0 ? " is-center" : ""}`}
                role="listitem"
                data-index={i}
              >
                <span class="hero-ph" style={`background-image:url("${lqipMap[f.file]}")`}>
                  <Image
                    class="blurup"
                    src={f.img}
                    alt={f.alt}
                    widths={[640, 1024, 1600, 1920]}
                    sizes="(max-width: 860px) 90vw, 60vw"
                    quality={82}
                    loading={i <= 1 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : "auto"}
                  />
                </span>
              </figure>
            ))
          }
        </div>

        <div class="hero-bar">
          <div class="hero-nav">
            <button type="button" class="hero-arrow hero-prev" aria-label="Previous photograph">
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M7.5 1.5 L3 6 L7.5 10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <span class="hero-count"><span class="hero-cur">1</span> / {frames.length}</span>
            <button type="button" class="hero-arrow hero-next" aria-label="Next photograph">
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 1.5 L9 6 L4.5 10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
          </div>
        </div>
      </>
    )
  }
</section>

<script>
  function initHero() {
    const hero = document.querySelector<HTMLElement>(".hero");
    if (!hero || hero.dataset.init) return;
    const strip = hero.querySelector<HTMLElement>(".hero-strip");
    const frames = Array.from(hero.querySelectorAll<HTMLElement>(".hero-frame"));
    const prevBtn = hero.querySelector<HTMLButtonElement>(".hero-prev");
    const nextBtn = hero.querySelector<HTMLButtonElement>(".hero-next");
    const curEl = hero.querySelector<HTMLElement>(".hero-cur");
    if (!strip || frames.length < 2) return;
    hero.dataset.init = "1";

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const n = frames.length;

    // Clone the first and last frames onto the opposite ends of the strip so
    // arrowing (or swiping) past either end glides into a duplicate, then
    // silently teleports onto the real frame it matches — see settle()
    // below. Since the clone is pixel-identical, the jump is invisible and
    // the carousel appears to loop forever.
    const firstClone = frames[0].cloneNode(true) as HTMLElement;
    const lastClone = frames[n - 1].cloneNode(true) as HTMLElement;
    firstClone.setAttribute("aria-hidden", "true");
    lastClone.setAttribute("aria-hidden", "true");
    firstClone.removeAttribute("role");
    lastClone.removeAttribute("role");
    strip.append(firstClone);
    strip.prepend(lastClone);

    const allFrames = [lastClone, ...frames, firstClone];
    const lastIdx = allFrames.length - 1;
    let cur = 1; // index into allFrames of the first real frame

    // Update the counter for the current frame, mapping boundary clones back
    // onto the real frame number they duplicate.
    function updateChrome() {
      if (curEl) curEl.textContent = String(cur === 0 ? n : cur === lastIdx ? 1 : cur);
    }

    // Paint each frame's scale + opacity from its distance to screen centre,
    // and surface whichever frame is closest to centre as the current one.
    let raf = 0;
    function paint() {
      raf = 0;
      const mid = window.innerWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      allFrames.forEach((f, i) => {
        const r = f.getBoundingClientRect();
        const c = r.left + r.width / 2;
        const dist = Math.abs(c - mid);
        // 0 at centre → 1 once a frame is a full half-viewport away.
        const t = Math.min(1, dist / (window.innerWidth * 0.5));
        f.style.setProperty("--s", (1 - 0.16 * t).toFixed(3));
        f.style.setProperty("--o", (1 - 0.6 * t).toFixed(3));
        f.classList.toggle("is-center", t < 0.12);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      });
      if (best !== cur) {
        cur = best;
        updateChrome();
      }
    }
    function schedule() {
      if (!raf) raf = window.requestAnimationFrame(paint);
    }

    // Instantly re-centre on frame `i` with no animation — used to hop from
    // a boundary clone onto the real frame it duplicates.
    function teleportTo(i: number) {
      const f = allFrames[i];
      const sr = strip.getBoundingClientRect();
      const fr = f.getBoundingClientRect();
      const prevSnap = strip.style.scrollSnapType;
      strip.style.scrollSnapType = "none";
      strip.scrollLeft += fr.left + fr.width / 2 - (sr.left + sr.width / 2);
      strip.style.scrollSnapType = prevSnap;
      cur = i;
      updateChrome();
    }

    // Called once a navigation to frame `i` has finished. Landing on a
    // boundary clone (0 or lastIdx) teleports onto the matching real frame
    // so the next step continues the loop instead of hitting a dead end.
    function settle(i: number) {
      if (i === 0) teleportTo(n);
      else if (i === lastIdx) teleportTo(1);
      else {
        cur = i;
        updateChrome();
      }
    }

    // Smoothly bring frame `i` to the centre of the screen. We tween
    // scrollLeft ourselves (native smooth scroll is unreliable while
    // scroll-snap is mandatory), lifting snap for the duration of the glide.
    let animId = 0;
    function centerOn(i: number) {
      const clamped = Math.max(0, Math.min(lastIdx, i));
      const f = allFrames[clamped];
      const sr = strip.getBoundingClientRect();
      const fr = f.getBoundingClientRect();
      const from = strip.scrollLeft;
      const to = from + (fr.left + fr.width / 2 - (sr.left + sr.width / 2));
      const dist = to - from;
      if (reduce || Math.abs(dist) < 2) {
        strip.scrollLeft = to;
        settle(clamped);
        schedule();
        return;
      }
      const id = ++animId;
      strip.style.scrollSnapType = "none";
      const dur = 460;
      const t0 = performance.now();
      function step(now: number) {
        if (id !== animId) return; // a newer navigation superseded this one
        const p = Math.min(1, (now - t0) / dur);
        const e = p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2; // easeInOut
        strip.scrollLeft = from + dist * e;
        schedule();
        if (p < 1) requestAnimationFrame(step);
        else {
          strip.style.scrollSnapType = "";
          settle(clamped);
        }
      }
      requestAnimationFrame(step);
    }

    // Arrows are the primary control, and — since the strip loops — are
    // never disabled. Click a neighbouring frame to centre it, and
    // Left/Right arrow keys step too. The mouse wheel is left alone, so
    // scrolling up and down the page works normally over the hero.
    prevBtn?.addEventListener("click", () => centerOn(cur - 1));
    nextBtn?.addEventListener("click", () => centerOn(cur + 1));
    allFrames.forEach((f, i) =>
      f.addEventListener("click", () => {
        if (i !== cur) centerOn(i);
      }),
    );
    strip.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        centerOn(cur + 1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        centerOn(cur - 1);
      }
    });

    // If the visitor scrolls/swipes by hand all the way to a boundary clone
    // (rather than via the arrows), teleport onto the matching real frame
    // once the scroll settles.
    let scrollEndTimer = 0;
    strip.addEventListener(
      "scroll",
      () => {
        schedule();
        window.clearTimeout(scrollEndTimer);
        scrollEndTimer = window.setTimeout(() => {
          if (cur === 0) teleportTo(n);
          else if (cur === lastIdx) teleportTo(1);
        }, 120);
      },
      { passive: true },
    );
    window.addEventListener("resize", () => {
      centerOn(cur);
      schedule();
    });

    // Start with the first real frame centred.
    requestAnimationFrame(() => {
      centerOn(1);
      updateChrome();
      schedule();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHero, { once: true });
  } else {
    initHero();
  }
  document.addEventListener("astro:page-load", initHero);
</script>
