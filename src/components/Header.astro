---
const links = [
  { href: "/work", label: "Work" },
  { href: "/#about", label: "About" },
  { href: "/book", label: "Booking" },
  { href: "/prints", label: "Prints" },
  { href: "/contact", label: "Contact" },
];

const NAME = "Owen McCullum";
---

<header class="site-header" transition:persist>
  <div class="wrap bar">
    <a class="name" href="/" aria-label={NAME}>{NAME}</a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="nt-bars" aria-hidden="true"></span>
    </button>

    <nav id="site-nav">
      {
        links.map((l) => (
          <a href={l.href} data-astro-reload={l.reload}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  // --- Mobile navigation (hamburger) ---
  function wireNav() {
    const header = document.querySelector<HTMLElement>(".site-header");
    const btn = header?.querySelector<HTMLButtonElement>(".nav-toggle");
    if (!header || !btn || btn.dataset.wired) return;
    btn.dataset.wired = "1";

    const close = () => {
      header.classList.remove("nav-open");
      btn.setAttribute("aria-expanded", "false");
    };
    btn.addEventListener("click", () => {
      const open = header.classList.toggle("nav-open");
      btn.setAttribute("aria-expanded", String(open));
    });
    header
      .querySelectorAll("nav a")
      .forEach((a) => a.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
    document.addEventListener("astro:before-swap", close);
  }

  // Highlight the nav link for the current page (header persists across
  // View Transitions, so this runs on every navigation).
  function setActiveNav() {
    const path = (location.pathname.replace(/\/+$/, "") || "/") + "/";
    document
      .querySelectorAll<HTMLAnchorElement>(".site-header nav a")
      .forEach((a) => {
        const href = a.getAttribute("href") || "";
        const active =
          !href.startsWith("/#") &&
          href !== "/" &&
          path.startsWith(href.replace(/\/+$/, "") + "/");
        a.classList.toggle("active", active);
        if (active) a.setAttribute("aria-current", "page");
        else a.removeAttribute("aria-current");
      });
  }

  wireNav();
  setActiveNav();
  document.addEventListener("astro:page-load", () => {
    wireNav();
    setActiveNav();
  });
</script>
