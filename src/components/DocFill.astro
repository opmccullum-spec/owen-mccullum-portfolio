---
// A value the admin already filled in on the contract signing page, shown as
// plain text in the agreement (only the blanks the CLIENT fills in — the
// .doc-fill-input fields — are highlighted). Optional fields the admin left
// blank show a muted placeholder instead.
interface Props {
  value?: string | null;
  placeholder?: string;
}
const { value, placeholder = "(not specified)" } = Astro.props;
---

{
  value ? (
    <span class="doc-fill">{value}</span>
  ) : (
    <span class="doc-fill doc-fill-empty">{placeholder}</span>
  )
}
