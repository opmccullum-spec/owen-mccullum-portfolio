---
import { Image } from "astro:assets";
import portrait from "../assets/portrait.jpg";
---

<section class="wrap about" id="about">
  <div class="about-grid">
    <figure class="portrait reveal">
      <Image
        src={portrait}
        alt="Owen McCullum"
        widths={[160, 240, 320]}
        sizes="(max-width: 860px) 140px, 160px"
        loading="lazy"
      />
    </figure>
    <div class="reveal" style="--d:140ms">
      <div class="k">About</div>
      <p>
        I grew up near the Adirondack mountains in upstate NY, where I first
        got hooked on photography. Photography has always been about
        connection and curiosity to me, having first used it as a medium to
        appreciate the nature-filled world of my childhood. As I've migrated
        south throughout my life, I've become more interested in people,
        their stories and emotions.
      </p>
      <p class="small">
        Available for headshots, portraits, and editorial assignments. Prints
        and licensing on request.
      </p>
    </div>
  </div>
</section>
