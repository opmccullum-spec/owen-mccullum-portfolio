---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Work from "../../components/Work.astro";

const title = "Work — Owen McCullum";
const description = "Documentary portraits from Washington, D.C. by Owen McCullum.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="wrap page">
    <header class="page-head reveal">
      <p class="page-eyebrow">Work</p>
      <h1 class="page-title">Portraits.</h1>
      <p class="page-lede">Documentary portrait work from Washington, D.C.</p>
    </header>

    <Work />
  </main>
  <Footer />
</BaseLayout>
