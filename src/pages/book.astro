---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getOptionalProfile } from "../lib/auth";

// Public page — works whether or not the visitor has ever logged in. If
// they happen to be logged in already, prefill their name/email.
const session = await getOptionalProfile(Astro.request, Astro.cookies);
const prefillName = session?.profile.full_name ?? "";
const prefillEmail = session?.user.email ?? "";
---

<BaseLayout title="Book a Session — Owen McCullum" description="Request a session date and time with Owen McCullum.">
  <Header />
  <main class="wrap page">
    <header class="page-head reveal">
      <p class="page-eyebrow">Scheduling</p>
      <h1 class="page-title">Book a session.</h1>
      <p class="page-lede">
        Pick an open time below and send a request — this isn't instant-booked; Owen reviews and confirms
        each request personally, usually within a day or two.
      </p>
    </header>

    <section class="calc reveal" id="price-calc" aria-label="Price calculator">
      <p class="inq-eyebrow">Estimate your price</p>

      <div class="calc-cats" role="group" aria-label="Session type">
        <button type="button" class="calc-cat active" data-category="family">Family</button>
        <button type="button" class="calc-cat" data-category="events">Events</button>
        <button type="button" class="calc-cat" data-category="proposals">Proposals</button>
        <button type="button" class="calc-cat" data-category="portraits">Portraits &amp; Headshots</button>
      </div>

      <div class="calc-row">
        <div class="inq-field calc-date-field">
          <label for="calc-date">Date</label>
          <input id="calc-date" type="date" />
        </div>
        <div class="inq-field calc-hours-field">
          <label for="calc-hours-value">Hours</label>
          <div class="calc-stepper">
            <button type="button" class="calc-step" id="calc-hours-minus" aria-label="Decrease hours">−</button>
            <span id="calc-hours-value">1</span>
            <button type="button" class="calc-step" id="calc-hours-plus" aria-label="Increase hours">+</button>
          </div>
        </div>
      </div>

      <p class="inq-note" id="calc-estimate-text">Pick a date to see your estimate.</p>
      <button type="button" class="inq-note calc-use-btn" id="calc-use-date" hidden>Use this date to book below ↓</button>
    </section>

    <div id="book-app" class="reveal">
      <p id="book-status" class="inq-note">Loading available times…</p>

      <div id="slot-picker" class="inquire" hidden>
        <div class="inq-field">
          <label for="day-input">Choose a day</label>
          <input id="day-input" type="date" />
        </div>

        <div class="inq-field" id="time-field" hidden>
          <label for="slot-select">Choose a time</label>
          <select id="slot-select">
            <option value="" disabled selected>Select a time…</option>
          </select>
          <span class="inq-note" id="time-hint" hidden>No standard times that day — choose "Other" to request one.</span>
        </div>

        <div class="inq-field" id="other-time-field" hidden>
          <label for="other-time-input">Preferred time</label>
          <input id="other-time-input" type="time" />
        </div>
      </div>

      <form id="book-form" class="inquire" hidden novalidate>
        <p class="inq-eyebrow" id="book-selected-summary">Selected time</p>

        <div class="inq-field">
          <label for="bk-name">Your name</label>
          <input id="bk-name" name="name" type="text" required value={prefillName} />
        </div>

        <div class="inq-field">
          <label for="bk-email">Email</label>
          <input id="bk-email" name="email" type="email" required value={prefillEmail} />
        </div>

        <div class="inq-field">
          <label for="bk-note">Anything Owen should know? (optional)</label>
          <textarea id="bk-note" name="note" rows="3" maxlength="500"></textarea>
        </div>

        <div class="hp-field" aria-hidden="true">
          <label for="bk-company">Company</label>
          <input id="bk-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <p class="inq-feedback inq-error" id="book-error" role="alert" hidden></p>

        <button class="inq-submit" type="submit">Request this time</button>
        <button class="inq-note book-change-btn" type="button" id="book-change">← Choose a different time</button>
      </form>

      <div id="book-confirmation" class="inq-feedback" role="status" hidden></div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* .inquire/.inq-* and #slot-days both set their own `display`, which
     otherwise beats the browser's default `[hidden]{display:none}` rule
     (an author style always wins over a user-agent one, regardless of
     selector specificity) — so [hidden] needs to be spelled out here. */
  #book-app [hidden],
  #price-calc [hidden] {
    display: none !important;
  }

  #slot-picker {
    margin-top: 24px;
  }
  .hp-field {
    position: absolute;
    left: -9999px;
    height: 0;
    overflow: hidden;
  }
  .book-change-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
  }

  /* Price calculator */
  .calc {
    max-width: 560px;
    padding-bottom: 40px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .calc-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 26px;
  }
  .calc-cat {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 9px 16px;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }
  .calc-cat:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .calc-cat.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .calc-row {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }
  .calc-date-field {
    flex: 1 1 220px;
  }
  .calc-hours-field {
    flex: 0 0 auto;
  }
  .calc-stepper {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 9px 0;
  }
  .calc-stepper span {
    font-family: var(--sans);
    font-weight: 300;
    font-size: 16px;
    min-width: 1.5ch;
    text-align: center;
  }
  .calc-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: none;
    color: var(--ink);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }
  .calc-step:hover:not(:disabled) {
    border-color: var(--ink);
  }
  .calc-step:disabled {
    opacity: 0.3;
    cursor: default;
  }
  #calc-estimate-text {
    margin-top: 24px;
    font-family: var(--sans);
    font-weight: 300;
    font-size: 17px;
    letter-spacing: normal;
    text-transform: none;
    color: var(--ink);
  }
  .calc-use-btn {
    display: inline-block;
    margin-top: 12px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
  }
</style>

<script>
  import { calculatePrice, CATEGORY_LABELS, MIN_HOURS, MAX_HOURS, type BookingCategory } from "../lib/pricing";

  type Slot = { startISO: string; endISO: string };
  type Selected = { startISO: string; label: string };

  // Shared with the booking form's submit handler below, so the estimate
  // the visitor saw is exactly what gets attached to their request.
  let calcCategory: BookingCategory = "family";
  let calcHours = 1;

  function money(cents: number) {
    return (cents / 100).toLocaleString("en-US", { style: "currency", currency: "USD" });
  }

  function initCalculator() {
    const root = document.querySelector<HTMLElement>("#price-calc");
    if (!root || root.dataset.init) return;
    root.dataset.init = "1";

    const catButtons = Array.from(root.querySelectorAll<HTMLButtonElement>(".calc-cat"));
    const dateInput = root.querySelector<HTMLInputElement>("#calc-date")!;
    const hoursValueEl = root.querySelector<HTMLElement>("#calc-hours-value")!;
    const minusBtn = root.querySelector<HTMLButtonElement>("#calc-hours-minus")!;
    const plusBtn = root.querySelector<HTMLButtonElement>("#calc-hours-plus")!;
    const estimateText = root.querySelector<HTMLElement>("#calc-estimate-text")!;
    const useDateBtn = root.querySelector<HTMLButtonElement>("#calc-use-date")!;

    dateInput.min = (() => {
      const d = new Date();
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
    })();

    function update() {
      hoursValueEl.textContent = String(calcHours);
      minusBtn.disabled = calcHours <= MIN_HOURS;
      plusBtn.disabled = calcHours >= MAX_HOURS;

      if (!dateInput.value) {
        estimateText.textContent = "Pick a date to see your estimate.";
        useDateBtn.hidden = true;
        return;
      }

      const price = calculatePrice(calcCategory, calcHours, dateInput.value);
      estimateText.textContent = "";
      estimateText.append(
        `${CATEGORY_LABELS[calcCategory]}, ${calcHours} hour${calcHours === 1 ? "" : "s"}: `,
        Object.assign(document.createElement("strong"), { textContent: money(price.totalCents) }),
        price.isHoliday ? " (includes a 20% holiday rate)" : "",
      );
      useDateBtn.hidden = false;
    }

    catButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        calcCategory = btn.dataset.category as BookingCategory;
        catButtons.forEach((b) => b.classList.toggle("active", b === btn));
        update();
      });
    });

    minusBtn.addEventListener("click", () => {
      calcHours = Math.max(MIN_HOURS, calcHours - 1);
      update();
    });
    plusBtn.addEventListener("click", () => {
      calcHours = Math.min(MAX_HOURS, calcHours + 1);
      update();
    });
    dateInput.addEventListener("change", update);

    useDateBtn.addEventListener("click", () => {
      const bookDayInput = document.querySelector<HTMLInputElement>("#day-input");
      const bookApp = document.querySelector<HTMLElement>("#book-app");
      if (bookDayInput && dateInput.value) {
        bookDayInput.value = dateInput.value;
        bookDayInput.dispatchEvent(new Event("change"));
      }
      bookApp?.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    update();
  }

  function initBooking() {
    const app = document.querySelector<HTMLElement>("#book-app");
    if (!app || app.dataset.init) return;
    app.dataset.init = "1";

    const statusEl = document.querySelector<HTMLElement>("#book-status")!;
    const pickerEl = document.querySelector<HTMLElement>("#slot-picker")!;
    const dayInputEl = document.querySelector<HTMLInputElement>("#day-input")!;
    const timeFieldEl = document.querySelector<HTMLElement>("#time-field")!;
    const selectEl = document.querySelector<HTMLSelectElement>("#slot-select")!;
    const timeHintEl = document.querySelector<HTMLElement>("#time-hint")!;
    const otherFieldEl = document.querySelector<HTMLElement>("#other-time-field")!;
    const otherInputEl = document.querySelector<HTMLInputElement>("#other-time-input")!;
    const formEl = document.querySelector<HTMLFormElement>("#book-form")!;
    const summaryEl = document.querySelector<HTMLElement>("#book-selected-summary")!;
    const errorEl = document.querySelector<HTMLElement>("#book-error")!;
    const confirmationEl = document.querySelector<HTMLElement>("#book-confirmation")!;
    const changeBtn = document.querySelector<HTMLButtonElement>("#book-change")!;

    let selected: Selected | null = null;
    let slotsByDay = new Map<string, Slot[]>();

    function showError(message: string) {
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    // Local (visitor's own timezone) YYYY-MM-DD, matching what a native
    // <input type="date"> produces — so a slot's day lines up with the day
    // the visitor actually picked in the calendar.
    function localDateKey(d: Date): string {
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, "0");
      const day = String(d.getDate()).padStart(2, "0");
      return `${y}-${m}-${day}`;
    }

    function resetPicker() {
      dayInputEl.value = "";
      timeFieldEl.hidden = true;
      selectEl.value = "";
      otherFieldEl.hidden = true;
      otherInputEl.value = "";
      pickerEl.hidden = false;
    }

    function renderSlots(slots: Slot[]) {
      slotsByDay = new Map();
      for (const slot of slots) {
        const key = localDateKey(new Date(slot.startISO));
        if (!slotsByDay.has(key)) slotsByDay.set(key, []);
        slotsByDay.get(key)!.push(slot);
      }

      dayInputEl.min = localDateKey(new Date());
      statusEl.hidden = true;
      pickerEl.hidden = false;
    }

    function populateTimesForDay(dateKey: string) {
      const daySlots = slotsByDay.get(dateKey) ?? [];

      selectEl.innerHTML = "";
      const placeholder = new Option("Select a time…", "", true, true);
      placeholder.disabled = true;
      selectEl.add(placeholder);
      for (const slot of daySlots) {
        const timeLabel = new Date(slot.startISO).toLocaleTimeString(undefined, {
          hour: "numeric",
          minute: "2-digit",
        });
        selectEl.add(new Option(timeLabel, slot.startISO));
      }
      selectEl.add(new Option("Other — I'll specify a time", "other"));

      timeHintEl.hidden = daySlots.length > 0;
      otherFieldEl.hidden = true;
      timeFieldEl.hidden = false;
    }

    function proceedWithTime(startISO: string, dateForLabel: Date) {
      const label = dateForLabel.toLocaleString(undefined, {
        weekday: "long",
        month: "long",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit",
      });
      selected = { startISO, label };
      summaryEl.textContent = `Requesting: ${label}`;

      pickerEl.hidden = true;
      formEl.hidden = false;
      errorEl.hidden = true;
    }

    dayInputEl.addEventListener("change", () => {
      selectEl.value = "";
      otherFieldEl.hidden = true;
      otherInputEl.value = "";
      if (!dayInputEl.value) {
        timeFieldEl.hidden = true;
        return;
      }
      populateTimesForDay(dayInputEl.value);
    });

    selectEl.addEventListener("change", () => {
      const value = selectEl.value;
      if (!value) return;
      if (value === "other") {
        otherFieldEl.hidden = false;
        otherInputEl.value = "";
        otherInputEl.focus();
        return;
      }
      otherFieldEl.hidden = true;
      proceedWithTime(value, new Date(value));
    });

    otherInputEl.addEventListener("change", () => {
      if (!otherInputEl.value || !dayInputEl.value) return;
      // Combining the calendar day with a plain HH:MM has no timezone info,
      // so the browser (correctly) parses it as the visitor's own local
      // wall-clock time on that day.
      const d = new Date(`${dayInputEl.value}T${otherInputEl.value}:00`);
      if (isNaN(d.getTime()) || d.getTime() < Date.now()) {
        showError("Please choose a time in the future.");
        return;
      }
      proceedWithTime(d.toISOString(), d);
    });

    changeBtn.addEventListener("click", () => {
      formEl.hidden = true;
      resetPicker();
      selected = null;
    });

    async function loadSlots() {
      try {
        const res = await fetch("/api/availability");
        const data = await res.json();
        if (!data.ok) throw new Error(data.error || "unavailable");
        renderSlots(data.slots as Slot[]);
      } catch {
        statusEl.textContent = "Couldn't load available times — please try again shortly.";
      }
    }

    formEl.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!selected) return;
      errorEl.hidden = true;

      const submitBtn = formEl.querySelector<HTMLButtonElement>(".inq-submit")!;
      submitBtn.disabled = true;

      const formData = new FormData(formEl);
      try {
        const res = await fetch("/api/bookings/create", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: formData.get("name"),
            email: formData.get("email"),
            note: formData.get("note"),
            company: formData.get("company"),
            startISO: selected.startISO,
            category: calcCategory,
            hours: calcHours,
          }),
        });
        const data = await res.json();

        if (data.ok) {
          formEl.hidden = true;
          const email = String(formData.get("email"));
          confirmationEl.textContent = "";
          confirmationEl.append(
            "Request sent for ",
            Object.assign(document.createElement("strong"), { textContent: selected.label }),
            "! We've saved this under ",
            Object.assign(document.createElement("strong"), { textContent: email }),
            ". Owen will review it and follow up soon. To check on it, reschedule, or cancel later, log in anytime at the ",
            Object.assign(document.createElement("a"), { href: "/portal/login", textContent: "client portal" }),
            " with that same email — no password needed.",
          );
          confirmationEl.hidden = false;
          return;
        }

        if (data.error === "slot_taken") {
          showError("That time was just taken by someone else — please pick another.");
          formEl.hidden = true;
          resetPicker();
          selected = null;
          loadSlots();
        } else if (data.error === "rate_limited") {
          showError("Too many requests from here recently — please email Owen directly for now.");
        } else {
          showError("Something went wrong sending that request. Please try again.");
        }
      } catch {
        showError("Something went wrong sending that request. Please try again.");
      } finally {
        submitBtn.disabled = false;
      }
    });

    loadSlots();
  }

  function initAll() {
    initCalculator();
    initBooking();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll, { once: true });
  } else {
    initAll();
  }
  document.addEventListener("astro:page-load", initAll);
</script>
