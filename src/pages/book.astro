---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Book a Session — Owen McCullum" description="Request a session date and time with Owen McCullum.">
  <Header />
  <main class="wrap page">
    <header class="page-head reveal">
      <p class="page-eyebrow">Scheduling</p>
      <h1 class="page-title">Book a session.</h1>
      <p class="page-lede">Requests are reviewed and confirmed usually within a day or two.</p>
    </header>

    <section class="calc reveal" id="price-calc" aria-label="Price calculator">
      <p class="inq-eyebrow">Type of session:</p>

      <div class="calc-cats" role="group" aria-label="Session type">
        <button type="button" class="calc-cat active" data-category="family">Family</button>
        <button type="button" class="calc-cat" data-category="events">Events</button>
        <button type="button" class="calc-cat" data-category="proposals">Proposals</button>
        <button type="button" class="calc-cat" data-category="portraits">Portraits &amp; Headshots</button>
      </div>

      <p class="inq-eyebrow calc-label">Date:</p>
      <div class="calc-date-field">
        <input id="calc-date" type="date" aria-label="Date" />
      </div>

      <p class="inq-eyebrow calc-label">Hours:</p>
      <div class="calc-stepper" role="group" aria-label="Hours">
        <button type="button" class="calc-step" id="calc-hours-minus" aria-label="Decrease hours">−</button>
        <span id="calc-hours-value">1</span>
        <button type="button" class="calc-step" id="calc-hours-plus" aria-label="Increase hours">+</button>
      </div>

    </section>

    <div id="book-app" class="reveal">
      <div id="slot-picker" class="inquire">
        <div class="inq-field" id="time-field">
          <label for="time-input">Choose a time</label>
          <input id="time-input" type="time" />
        </div>
      </div>

      <form id="book-form" class="inquire" hidden novalidate>
        <div>
          <p class="inq-eyebrow" id="book-selected-summary">Selected time</p>
          <p class="book-price" id="book-price"></p>
        </div>

        <div class="inq-field">
          <label for="bk-name">Your name</label>
          <input id="bk-name" name="name" type="text" placeholder="Type name here" required />
        </div>

        <div class="inq-field">
          <label for="bk-email">Email</label>
          <input id="bk-email" name="email" type="email" placeholder="you@example.com" required />
        </div>

        <div class="inq-field">
          <label for="bk-note">Anything Owen should know? (optional)</label>
          <textarea id="bk-note" name="note" rows="3" maxlength="500"></textarea>
        </div>

        <div class="hp-field" aria-hidden="true">
          <label for="bk-company">Company</label>
          <input id="bk-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <p class="inq-feedback inq-error" id="book-error" role="alert" hidden></p>

        <button class="inq-submit" type="submit" id="book-submit">Request this time</button>
      </form>

      <div id="book-confirmation" class="inq-feedback" role="status" hidden></div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* .inquire/.inq-* and #slot-days both set their own `display`, which
     otherwise beats the browser's default `[hidden]{display:none}` rule
     (an author style always wins over a user-agent one, regardless of
     selector specificity) — so [hidden] needs to be spelled out here. */
  #book-app [hidden],
  #price-calc [hidden] {
    display: none !important;
  }

  /* One consistent rhythm for the whole page: 32px between one field and
     the next, 8px between a field's own label and its control (matching
     .inq-field's existing 8px gap, so "Choose a time"/"Your name"/etc.
     line up with "Date:"/"Hours:" above them). Scoped to this page only —
     .inquire/.inq-field are shared globally, and other forms shouldn't
     shift just because this one did. */
  .inquire {
    gap: 32px;
  }
  #slot-picker,
  #book-form,
  #book-confirmation {
    margin-top: 32px;
  }
  .hp-field {
    position: absolute;
    left: -9999px;
    height: 0;
    overflow: hidden;
  }
  /* Price calculator */
  .calc {
    max-width: 560px;
    padding-bottom: 40px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .calc-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 8px 0 32px;
  }
  .calc-cat {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 9px 16px;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }
  .calc-cat:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .calc-cat.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .calc-label {
    margin-top: 32px;
    margin-bottom: 8px;
  }
  .calc-date-field input {
    font-family: var(--sans);
    font-weight: 300;
    font-size: 16px;
    color: var(--ink);
    background: none;
    border: none;
    border-bottom: 1px solid var(--line);
    padding: 9px 0;
    width: 100%;
    max-width: 220px;
  }
  .calc-date-field input:focus {
    outline: none;
    border-bottom-color: var(--ink);
  }
  .calc-stepper {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 9px 0;
  }
  .calc-stepper span {
    font-family: var(--sans);
    font-weight: 300;
    font-size: 16px;
    min-width: 1.5ch;
    text-align: center;
  }
  .calc-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: none;
    color: var(--ink);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }
  .calc-step:hover:not(:disabled) {
    border-color: var(--ink);
  }
  .calc-step:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .book-price {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(32px, 5vw, 48px);
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 6px 0 0;
  }
  /* :global — this span is created client-side (Object.assign(document.createElement(...))),
     so it never gets Astro's scoped data-attribute and needs an unscoped selector. */
  .book-price :global(.holiday-note) {
    display: block;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
    margin-top: 6px;
  }
</style>

<script>
  import { calculatePrice, CATEGORY_LABELS, MIN_HOURS, MAX_HOURS, type BookingCategory } from "../lib/pricing";

  type Selected = { startISO: string; label: string };

  function money(cents: number) {
    return (cents / 100).toLocaleString("en-US", { style: "currency", currency: "USD" });
  }

  // Local (visitor's own timezone) YYYY-MM-DD, matching what a native
  // <input type="date"> produces — used only to floor the date picker's
  // minimum to "today."
  function localDateKey(d: Date): string {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, "0");
    const day = String(d.getDate()).padStart(2, "0");
    return `${y}-${m}-${day}`;
  }

  function initAll() {
    const app = document.querySelector<HTMLElement>("#book-app");
    const calc = document.querySelector<HTMLElement>("#price-calc");
    if (!app || !calc || app.dataset.init) return;
    app.dataset.init = "1";

    // One shared date input drives both the price estimate and which times
    // are offered below — no second "choose a day" field.
    const dateInput = document.querySelector<HTMLInputElement>("#calc-date")!;
    const catButtons = Array.from(calc.querySelectorAll<HTMLButtonElement>(".calc-cat"));
    const hoursValueEl = document.querySelector<HTMLElement>("#calc-hours-value")!;
    const minusBtn = document.querySelector<HTMLButtonElement>("#calc-hours-minus")!;
    const plusBtn = document.querySelector<HTMLButtonElement>("#calc-hours-plus")!;

    const pickerEl = document.querySelector<HTMLElement>("#slot-picker")!;
    const timeInputEl = document.querySelector<HTMLInputElement>("#time-input")!;
    const formEl = document.querySelector<HTMLFormElement>("#book-form")!;
    const summaryEl = document.querySelector<HTMLElement>("#book-selected-summary")!;
    const priceEl = document.querySelector<HTMLElement>("#book-price")!;
    const submitBtn = document.querySelector<HTMLButtonElement>("#book-submit")!;
    const errorEl = document.querySelector<HTMLElement>("#book-error")!;
    const confirmationEl = document.querySelector<HTMLElement>("#book-confirmation")!;

    let calcCategory: BookingCategory = "family";
    let calcHours = 1;
    let selected: Selected | null = null;

    dateInput.min = localDateKey(new Date());

    function showError(message: string) {
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    function proceedWithTime(startISO: string, dateForLabel: Date) {
      const dateLabel = dateForLabel.toLocaleString(undefined, {
        month: "long",
        day: "numeric",
        year: "numeric",
      });
      const timeLabel = dateForLabel.toLocaleString(undefined, {
        hour: "numeric",
        minute: "2-digit",
      });
      const hourWord = calcHours === 1 ? "hour" : "hours";
      const price = calculatePrice(calcCategory, calcHours, dateInput.value);
      const label = `${dateLabel} for ${calcHours} ${hourWord} starting at ${timeLabel}`;
      selected = { startISO, label };
      summaryEl.textContent = `Requesting ${CATEGORY_LABELS[calcCategory]}, ${label}.`;

      priceEl.textContent = "";
      priceEl.append(money(price.totalCents));
      if (price.isHoliday) {
        priceEl.append(
          Object.assign(document.createElement("span"), {
            className: "holiday-note",
            textContent: "Includes a 20% holiday rate",
          }),
        );
      }
      submitBtn.textContent = `Request this time — ${money(price.totalCents)}`;

      formEl.hidden = false;
      errorEl.hidden = true;
    }

    catButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        calcCategory = btn.dataset.category as BookingCategory;
        catButtons.forEach((b) => b.classList.toggle("active", b === btn));
      });
    });
    minusBtn.addEventListener("click", () => {
      calcHours = Math.max(MIN_HOURS, calcHours - 1);
      hoursValueEl.textContent = String(calcHours);
      minusBtn.disabled = calcHours <= MIN_HOURS;
      plusBtn.disabled = calcHours >= MAX_HOURS;
    });
    plusBtn.addEventListener("click", () => {
      calcHours = Math.min(MAX_HOURS, calcHours + 1);
      hoursValueEl.textContent = String(calcHours);
      minusBtn.disabled = calcHours <= MIN_HOURS;
      plusBtn.disabled = calcHours >= MAX_HOURS;
    });

    dateInput.addEventListener("change", () => {
      timeInputEl.value = "";
    });

    timeInputEl.addEventListener("change", () => {
      if (!timeInputEl.value || !dateInput.value) return;
      // Combining the calendar day with a plain HH:MM has no timezone info,
      // so the browser (correctly) parses it as the visitor's own local
      // wall-clock time on that day.
      const d = new Date(`${dateInput.value}T${timeInputEl.value}:00`);
      if (isNaN(d.getTime()) || d.getTime() < Date.now()) {
        showError("Please choose a time in the future.");
        return;
      }
      proceedWithTime(d.toISOString(), d);
    });

    formEl.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!selected) return;
      errorEl.hidden = true;
      submitBtn.disabled = true;

      const formData = new FormData(formEl);
      try {
        const res = await fetch("/api/bookings/create", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: formData.get("name"),
            email: formData.get("email"),
            note: formData.get("note"),
            company: formData.get("company"),
            startISO: selected.startISO,
            category: calcCategory,
            hours: calcHours,
          }),
        });
        const data = await res.json();

        if (data.ok) {
          formEl.hidden = true;
          pickerEl.hidden = true;
          const email = String(formData.get("email"));
          confirmationEl.textContent = "";
          confirmationEl.append(
            "Request sent for ",
            Object.assign(document.createElement("strong"), { textContent: selected.label }),
            "! We've saved this under ",
            Object.assign(document.createElement("strong"), { textContent: email }),
            ". Owen will review it and follow up soon. To check on it, reschedule, or cancel later, log in anytime at the ",
            Object.assign(document.createElement("a"), { href: "/portal/login", textContent: "client portal" }),
            " with that same email — no password needed.",
          );
          confirmationEl.hidden = false;
          return;
        }

        if (data.error === "slot_taken") {
          showError("That time was just taken by someone else — please pick another.");
          formEl.hidden = true;
          selected = null;
          timeInputEl.value = "";
          pickerEl.hidden = false;
        } else if (data.error === "rate_limited") {
          showError("Too many requests from here recently — please email Owen directly for now.");
        } else {
          showError("Something went wrong sending that request. Please try again.");
        }
      } catch {
        showError("Something went wrong sending that request. Please try again.");
      } finally {
        submitBtn.disabled = false;
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll, { once: true });
  } else {
    initAll();
  }
  document.addEventListener("astro:page-load", initAll);
</script>
