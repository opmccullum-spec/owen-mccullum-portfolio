---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout title="Reset Password — Owen McCullum" description="Reset your admin password.">
  <Header />
  <main class="wrap page">
    <header class="page-head reveal">
      <p class="page-eyebrow">Admin</p>
      <h1 class="page-title">Reset your password.</h1>
      <p class="page-lede">Enter your admin email and we'll send you a link to set a new password.</p>
    </header>

    <form class="inquire reveal" id="forgot-form" novalidate>
      <p class="inq-eyebrow">Forgot password</p>

      <div class="inq-field inq-initial">
        <label for="forgot-email">Email</label>
        <input id="forgot-email" name="email" type="email" autocomplete="username" required />
        <span class="inq-err" aria-live="polite"></span>
      </div>

      <button class="inq-submit inq-initial" type="submit">Send reset link</button>

      <p class="inq-feedback inq-sent" role="status" hidden>
        Check your inbox — if that email has admin access, we've sent a link to reset your password.
      </p>
      <p class="inq-feedback inq-error inq-error--submit" role="alert" hidden>
        Something went wrong sending that link. Please try again in a moment.
      </p>

      <p class="inq-note inq-initial"><a href="/admin/login">← Back to login</a></p>
    </form>
  </main>
  <Footer />
</BaseLayout>

<script>
  function initForgot() {
    const form = document.querySelector<HTMLFormElement>("#forgot-form");
    if (!form || form.dataset.init) return;
    form.dataset.init = "1";

    const email = form.querySelector<HTMLInputElement>("[name=email]")!;
    const submit = form.querySelector<HTMLButtonElement>(".inq-submit")!;
    const sent = form.querySelector<HTMLElement>(".inq-sent")!;
    const errorBox = form.querySelector<HTMLElement>(".inq-error--submit")!;
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorBox.hidden = true;

      if (!emailRe.test(email.value.trim())) {
        const wrap = email.closest(".inq-field")!;
        wrap.classList.add("invalid");
        wrap.querySelector(".inq-err")!.textContent = "Please enter a valid email.";
        email.focus();
        return;
      }

      const original = submit.textContent;
      submit.disabled = true;
      submit.textContent = "Sending…";

      try {
        const res = await fetch("/api/auth/admin-forgot-password", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email.value.trim() }),
        });
        if (!res.ok) throw new Error("request failed");

        form.querySelectorAll(".inq-initial").forEach((el) => ((el as HTMLElement).hidden = true));
        sent.hidden = false;
      } catch {
        errorBox.hidden = false;
        submit.disabled = false;
        submit.textContent = original;
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initForgot, { once: true });
  } else {
    initForgot();
  }
  document.addEventListener("astro:page-load", initForgot);
</script>
