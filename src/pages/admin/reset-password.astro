---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { createSupabaseServerClient } from "../../lib/supabase/server";

const code = Astro.url.searchParams.get("code");
let linkInvalid = false;

if (code) {
  const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
  const { error } = await supabase.auth.exchangeCodeForSession(code);
  if (error) linkInvalid = true;
} else {
  // No code in the URL — only valid if a recovery session is somehow
  // already active (e.g. a page refresh after the code was consumed).
  const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
  const {
    data: { user },
  } = await supabase.auth.getUser();
  if (!user) linkInvalid = true;
}
---

<BaseLayout title="Set New Password — Owen McCullum" description="Set a new admin password.">
  <Header />
  <main class="wrap page">
    <header class="page-head reveal">
      <p class="page-eyebrow">Admin</p>
      <h1 class="page-title">Set a new password.</h1>
      <p class="page-lede">Choose a new password for your admin account.</p>
    </header>

    {linkInvalid ? (
      <p class="inq-feedback inq-error" role="alert">
        That reset link didn't work — it may have expired.
        <a href="/admin/forgot-password">Request a new one</a>.
      </p>
    ) : (
      <form class="inquire reveal" id="reset-form" novalidate>
        <p class="inq-eyebrow">New password</p>

        <div class="inq-field">
          <label for="reset-password">New password</label>
          <input id="reset-password" name="password" type="password" autocomplete="new-password" minlength="8" required />
          <span class="inq-err" aria-live="polite"></span>
        </div>

        <div class="inq-field">
          <label for="reset-confirm">Confirm new password</label>
          <input id="reset-confirm" name="confirm" type="password" autocomplete="new-password" minlength="8" required />
          <span class="inq-err" aria-live="polite"></span>
        </div>

        <button class="inq-submit" type="submit">Set password</button>

        <p class="inq-feedback inq-error" id="reset-error" role="alert" hidden></p>
      </form>
    )}
  </main>
  <Footer />
</BaseLayout>

<script>
  function initReset() {
    const form = document.querySelector<HTMLFormElement>("#reset-form");
    if (!form || form.dataset.init) return;
    form.dataset.init = "1";

    const password = form.querySelector<HTMLInputElement>("[name=password]")!;
    const confirm = form.querySelector<HTMLInputElement>("[name=confirm]")!;
    const submit = form.querySelector<HTMLButtonElement>(".inq-submit")!;
    const errorBox = form.querySelector<HTMLElement>("#reset-error")!;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorBox.hidden = true;

      if (password.value.length < 8) {
        errorBox.textContent = "Password must be at least 8 characters.";
        errorBox.hidden = false;
        return;
      }
      if (password.value !== confirm.value) {
        errorBox.textContent = "Passwords don't match.";
        errorBox.hidden = false;
        return;
      }

      const original = submit.textContent;
      submit.disabled = true;
      submit.textContent = "Saving…";

      try {
        const res = await fetch("/api/auth/set-password", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password: password.value }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || "failed");

        window.location.href = "/admin";
      } catch {
        errorBox.textContent = "Something went wrong setting your password. Please try again.";
        errorBox.hidden = false;
        submit.disabled = false;
        submit.textContent = original;
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initReset, { once: true });
  } else {
    initReset();
  }
  document.addEventListener("astro:page-load", initReset);
</script>
