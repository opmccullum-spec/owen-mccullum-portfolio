---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { requireAdmin } from "../../../lib/auth";
import { supabaseAdmin } from "../../../lib/supabase/admin";

const auth = await requireAdmin(Astro);
if (auth instanceof Response) return auth;

const error = Astro.url.searchParams.get("error");
const errorMessage = error === "create_failed" ? "Something went wrong creating that invoice. Please try again." : null;

// Default due date: 14 days out.
const defaultDue = new Date(Date.now() + 14 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);

// Optionally tie this invoice to a specific shoot, so the admin Clients
// table can show the right outstanding balance on that shoot's row.
const { data: shootOptions } = await supabaseAdmin
  .from("bookings")
  .select("id, starts_at, status, profiles(email, full_name)")
  .order("starts_at", { ascending: false });

function shootLabel(b: any) {
  const when = new Date(b.starts_at).toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" });
  const who = b.profiles?.full_name || b.profiles?.email || "unknown client";
  return `${when} — ${who}${b.status !== "confirmed" ? ` (${b.status})` : ""}`;
}
---

<BaseLayout title="New Invoice — Owen McCullum" description="Send a new invoice to a client.">
  <Header />
  <main class="wrap page">
    <header class="page-head reveal">
      <p class="page-eyebrow">Admin</p>
      <h1 class="page-title">New invoice.</h1>
      <p class="page-lede">
        Enter the client's email — if they've never logged into the portal before, an account is created for
        them automatically. Stripe emails them a link to pay.
      </p>
    </header>

    <p class="inq-note reveal" style="margin-bottom: 40px;"><a href="/admin">← Back to admin</a></p>

    <form class="inquire reveal" method="POST" action="/api/admin/invoices/create" novalidate id="invoice-form">
      <p class="inq-eyebrow">Invoice details</p>

      {shootOptions && shootOptions.length > 0 && (
        <div class="inq-field">
          <label for="inv-shoot">Shoot this invoice is for (optional)</label>
          <select id="inv-shoot" name="bookingId">
            <option value="">— Not tied to a specific shoot —</option>
            {shootOptions.map((b) => (
              <option value={b.id} data-email={b.profiles?.email ?? ""}>
                {shootLabel(b)}
              </option>
            ))}
          </select>
        </div>
      )}

      <div class="inq-field">
        <label for="inv-email">Client email</label>
        <input id="inv-email" name="email" type="email" autocomplete="off" required />
      </div>

      <div class="inv-items">
        <div class="inv-item-row">
          <div class="inq-field inv-item-desc">
            <label>Description</label>
            <input name="itemDescription[]" type="text" placeholder="e.g. Fall portrait session" required />
          </div>
          <div class="inq-field inv-item-amt">
            <label>Amount (USD)</label>
            <input name="itemAmount[]" type="number" min="0.01" step="0.01" placeholder="250.00" required />
          </div>
          <button type="button" class="inv-item-remove" aria-label="Remove line item" disabled>&times;</button>
        </div>
      </div>

      <button type="button" class="inq-note inv-add-item" style="justify-self: start; background: none; border: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px;">
        + Add another line item
      </button>

      <p class="inq-note inv-total">Total: <strong id="inv-total-amt">$0.00</strong></p>

      <div class="inq-field">
        <label for="inv-due">Due date</label>
        <input id="inv-due" name="dueDate" type="date" value={defaultDue} required />
      </div>

      {errorMessage && (
        <p class="inq-feedback inq-error" role="alert">
          {errorMessage}
        </p>
      )}

      <button class="inq-submit" type="submit">Create &amp; send invoice</button>
    </form>
  </main>
  <Footer />
</BaseLayout>

<script>
  function initInvoiceForm() {
    const form = document.querySelector<HTMLFormElement>("#invoice-form");
    if (!form || form.dataset.init) return;
    form.dataset.init = "1";

    const items = form.querySelector<HTMLElement>(".inv-items")!;
    const addBtn = form.querySelector<HTMLButtonElement>(".inv-add-item")!;
    const totalEl = form.querySelector<HTMLElement>("#inv-total-amt")!;

    // Picking a shoot pins the client — fill in and lock their email.
    const shoot = form.querySelector<HTMLSelectElement>("#inv-shoot");
    const emailInput = form.querySelector<HTMLInputElement>("#inv-email");
    if (shoot && emailInput) {
      shoot.addEventListener("change", () => {
        const em = shoot.selectedOptions[0]?.dataset.email || "";
        if (em) {
          emailInput.value = em;
          emailInput.readOnly = true;
        } else {
          emailInput.readOnly = false;
        }
      });
    }

    function rowTemplate(): HTMLElement {
      const row = items.querySelector(".inv-item-row")!.cloneNode(true) as HTMLElement;
      row.querySelectorAll("input").forEach((input) => (input.value = ""));
      return row;
    }

    function syncRemoveButtons() {
      const rows = items.querySelectorAll<HTMLElement>(".inv-item-row");
      rows.forEach((row) => {
        const btn = row.querySelector<HTMLButtonElement>(".inv-item-remove")!;
        btn.disabled = rows.length <= 1;
      });
    }

    function updateTotal() {
      let total = 0;
      items.querySelectorAll<HTMLInputElement>('input[name="itemAmount[]"]').forEach((input) => {
        const n = parseFloat(input.value);
        if (!isNaN(n) && n > 0) total += n;
      });
      totalEl.textContent = total.toLocaleString("en-US", { style: "currency", currency: "USD" });
    }

    addBtn.addEventListener("click", () => {
      items.appendChild(rowTemplate());
      syncRemoveButtons();
    });

    items.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".inv-item-remove");
      if (!btn || btn.disabled) return;
      btn.closest(".inv-item-row")!.remove();
      syncRemoveButtons();
      updateTotal();
    });

    items.addEventListener("input", updateTotal);

    syncRemoveButtons();
    updateTotal();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initInvoiceForm, { once: true });
  } else {
    initInvoiceForm();
  }
  document.addEventListener("astro:page-load", initInvoiceForm);
</script>
