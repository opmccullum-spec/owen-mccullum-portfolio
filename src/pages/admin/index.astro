---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { requireAdmin } from "../../lib/auth";
import { supabaseAdmin } from "../../lib/supabase/admin";
import { buildShootRow, countersignHref, money } from "../../lib/adminShoots";
import { buildAdminActions } from "../../lib/adminActions";
import { getBusinessTimezone, inTz } from "../../lib/businessTime";

const auth = await requireAdmin(Astro);
if (auth instanceof Response) return auth;

// The Clients view is a table with one row per shoot (booking) — every
// request ever made, newest-relevant first, with the contract and any
// invoices that were tied to that specific shoot pulled in alongside.
const { data: shoots } = await supabaseAdmin
  .from("bookings")
  .select("*, profiles(email, full_name), contracts(*), invoices(id, status, amount_cents, hosted_invoice_url)")
  .order("starts_at", { ascending: true });

// Contracts the client has signed that Owen still needs to countersign —
// including any not tied to a specific shoot.
const { data: needsCountersign } = await supabaseAdmin
  .from("contracts")
  .select("id, title, signed_at, profiles(email, full_name)")
  .eq("status", "signed")
  .is("countersigned_at", null);

const tz = await getBusinessTimezone();

const invoiced = Astro.url.searchParams.get("invoiced");
const emailed = Astro.url.searchParams.get("emailed") !== "0";
const invoiceUrl = Astro.url.searchParams.get("url");
const contracted = Astro.url.searchParams.get("contracted");
const countersigned = Astro.url.searchParams.get("countersigned");
const countersignEmailFailed = Astro.url.searchParams.get("emailed") === "0";
const approved = Astro.url.searchParams.get("approved");
const declined = Astro.url.searchParams.get("declined");
const cancelled = Astro.url.searchParams.get("cancelled");
const invoiceCancelled = Astro.url.searchParams.get("invoice_cancelled");
const contractCancelled = Astro.url.searchParams.get("contract_cancelled");
const photosSent = Astro.url.searchParams.get("photos_sent");
const bookingError = Astro.url.searchParams.get("error");
const bookingErrorMessage =
  bookingError === "slot_conflict"
    ? "That time is no longer free on your calendar — decline this request instead."
    : bookingError === "photos_failed"
      ? "Couldn't mark those photos as sent. Please try again."
      : bookingError === "approve_failed" || bookingError === "decline_failed" || bookingError === "cancel_failed"
      ? "Something went wrong with that booking action. Please try again."
      : bookingError === "invoice_not_cancellable" || bookingError === "contract_not_cancellable"
        ? "That can't be cancelled anymore — it's already been paid, signed, or cancelled."
        : bookingError === "invoice_cancel_failed" || bookingError === "contract_cancel_failed"
          ? "Something went wrong cancelling that. Please try again."
          : null;

// One view-model per shoot for the Clients table (shared with the
// per-client detail page's logic — see src/lib/adminShoots.ts).
const shootRows = (shoots ?? []).map((b: any) => buildShootRow(b));

// The "needed actions" message board above the table.
const actions = buildAdminActions({ bookings: shoots ?? [], needsCountersign: needsCountersign ?? [], tz });

// Default order: upcoming shoots first (soonest at top), then past shoots.
shootRows.sort(
  (a, b) => Number(a.isPast) - Number(b.isPast) || a.startMs - b.startMs,
);
---

<BaseLayout title="Admin — Owen McCullum" description="Owen's client portal admin dashboard.">
  <Header />
  <main class="wrap page">
    <header class="page-head reveal portal-head">
      <div>
        <p class="page-eyebrow">Admin</p>
        <h1 class="page-title">Clients</h1>
      </div>
      <form method="POST" action="/api/auth/signout" class="portal-signout">
        <input type="hidden" name="redirectTo" value="/admin/login" />
        <button type="submit" class="inq-note portal-signout-btn">Sign out</button>
      </form>
    </header>

    <p class="inq-note reveal" style="margin-bottom: 40px;">
      <a href="/portal">← Back to your own portal</a> · <a href="/admin/invoices/new">+ New invoice</a> ·{" "}
      <a href="/admin/contracts/new">+ New contract</a> · <a href="/admin/availability">Manage availability</a>
    </p>

    {invoiced && emailed && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Invoice created and emailed to the client.
      </p>
    )}
    {invoiced && !emailed && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Invoice created, but Stripe couldn't auto-email it yet (your Stripe account needs a bit more setup
        first — see Stripe's dashboard for what it's asking for). Share this link with the client yourself for now:{" "}
        <a href={invoiceUrl ?? "#"} target="_blank" rel="noopener">
          {invoiceUrl}
        </a>
      </p>
    )}
    {contracted && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Contract created and sent to the client for signature.
      </p>
    )}
    {countersigned && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        {countersignEmailFailed
          ? "Contract countersigned — it's now fully signed, but the email to the client couldn't be sent. Use View signed document to share the link with them."
          : "Contract countersigned — it's now fully signed, and a copy was emailed to the client."}
      </p>
    )}
    {photosSent && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Marked as sent — that reminder is cleared.
      </p>
    )}
    {approved && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Booking approved and added to your calendar.
      </p>
    )}
    {declined && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Booking request declined.
      </p>
    )}
    {cancelled && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Booking cancelled.
      </p>
    )}
    {invoiceCancelled && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Invoice cancelled.
      </p>
    )}
    {contractCancelled && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Contract cancelled.
      </p>
    )}
    {bookingErrorMessage && (
      <p class="inq-feedback inq-error reveal" role="alert" style="margin-bottom: 40px;">
        {bookingErrorMessage}
      </p>
    )}

    <section class="board reveal" aria-label="Needed actions">
      <h2 class="board-title">
        Needed actions
        {actions.length > 0 && <span class="board-count">{actions.length}</span>}
      </h2>
      {!actions.length ? (
        <p class="board-empty">You're all caught up — nothing needs your attention right now.</p>
      ) : (
        <ul class="board-list">
          {actions.map((a) => (
            <li class={`board-item${a.tone === "overdue" ? " is-overdue" : ""}`}>
              <div class="board-text">
                <p class="board-item-title">{a.title}</p>
                <p class="board-item-detail">{a.detail}</p>
              </div>
              <div class="board-actions">
                {a.buttons.map((btn) =>
                  btn.href ? (
                    <a class="portal-signout-btn" href={btn.href}>
                      {btn.label}
                    </a>
                  ) : (
                    <form
                      method="POST"
                      action={btn.post!.action}
                      style="display:inline;"
                      onsubmit={btn.confirm ? `return confirm(${JSON.stringify(btn.confirm)});` : undefined}
                    >
                      {Object.entries(btn.post!.fields).map(([name, value]) => (
                        <input type="hidden" name={name} value={value} />
                      ))}
                      <button type="submit" class="portal-signout-btn">
                        {btn.label}
                      </button>
                    </form>
                  ),
                )}
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    {!shootRows.length ? (
      <p class="reveal">No shoots booked yet.</p>
    ) : (
      <div class="at-wrap reveal">
        <table class="admin-table" id="clients-table">
          <thead>
            <tr>
              <th aria-sort="ascending">
                <button type="button" data-col="date" data-active="1" data-dir="asc">Date of session</button>
              </th>
              <th aria-sort="none"><button type="button" data-col="client">Client</button></th>
              <th aria-sort="none"><button type="button" data-col="email">Email</button></th>
              <th aria-sort="none"><button type="button" data-col="contract">Contract</button></th>
              <th aria-sort="none"><button type="button" data-col="payment">Payment</button></th>
            </tr>
          </thead>
          <tbody>
            {shootRows.map((r) => (
              <tr
                class={r.isPast ? "is-past" : undefined}
                data-past={r.isPast ? "1" : "0"}
                data-sort-date={String(r.startMs)}
                data-sort-client={r.clientName.toLowerCase()}
                data-sort-email={r.email.toLowerCase()}
                data-sort-contract={String(r.contractSort)}
                data-sort-payment={String(r.paymentSort)}
              >
                <td>
                  {inTz(r.start, tz, "EEE, MMM d, yyyy")}
                  <span class="at-sub">
                    {inTz(r.start, tz, "h:mm a")}
                    {r.status !== "confirmed" && <> · {r.status}</>}
                  </span>
                </td>
                <td class="at-client">
                  <a href={`/admin/clients/${r.clientId}`}>{r.clientName}</a>
                </td>
                <td>
                  <a href={`mailto:${r.email}`}>{r.email}</a>
                </td>
                <td>
                  {r.contractState === "none" ? (
                    <span class="at-none">None</span>
                  ) : (
                    <>
                      {r.contractHref ? (
                        <a href={r.contractHref} target="_blank" rel="noopener">
                          {r.contract?.title || "Contract"}
                        </a>
                      ) : (
                        <span>{r.contract?.title || "Contract"}</span>
                      )}
                      <span class={`at-sub${r.contractState === "overdue" ? " at-overdue" : ""}`}>
                        {r.contractState === "signed" && "Fully signed"}
                        {r.contractState === "countersign" && "Signed by client — needs your signature"}
                        {r.contractState === "due" && "Awaiting signature"}
                        {r.contractState === "overdue" &&
                          `Overdue by ${r.contractOverdueDays} day${r.contractOverdueDays === 1 ? "" : "s"}`}
                      </span>
                      {(r.contractState === "signed" || r.contractState === "countersign") && r.contract && (
                        <span class="at-actions">
                          {r.contractHref && (
                            <a class="portal-signout-btn" href={r.contractHref} target="_blank" rel="noopener">
                              View signed document
                            </a>
                          )}
                          {r.contractState === "countersign" && (
                            <a class="portal-signout-btn" href={countersignHref(r.contract.id)}>
                              Countersign
                            </a>
                          )}
                        </span>
                      )}
                    </>
                  )}
                </td>
                <td>
                  {r.paymentState === "none" ? (
                    <span class="at-none">No invoice</span>
                  ) : r.paymentState === "paid" ? (
                    <>
                      Paid<span class="at-sub">{money(r.paidCents)}</span>
                    </>
                  ) : r.payHref ? (
                    <a href={r.payHref} target="_blank" rel="noopener">
                      Owes {money(r.owedCents)}
                    </a>
                  ) : (
                    <>Owes {money(r.owedCents)}</>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </main>
  <Footer />
</BaseLayout>

<style>
  .board {
    margin-bottom: 56px;
    max-width: 880px;
  }
  .board-title {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mute);
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .board-count {
    background: var(--ink);
    color: var(--paper);
    border-radius: 999px;
    padding: 1px 9px;
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .board-empty {
    margin: 0;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--mute);
  }
  .board-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .board-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 20px;
  }
  .board-item + .board-item {
    border-top: 1px solid var(--line);
  }
  .board-item.is-overdue {
    background: rgba(179, 38, 30, 0.06);
  }
  .board-item.is-overdue .board-item-title {
    color: #b3261e;
  }
  .board-item-title {
    margin: 0 0 4px;
    font-weight: 500;
    line-height: 1.4;
  }
  .board-item-detail {
    margin: 0;
    font-size: 14px;
    color: var(--mute);
    line-height: 1.5;
  }
  .board-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .board-item {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  // Click any column header to sort the shoots table by that column; click
  // the active one again to flip direction. Past shoots always stay grouped
  // at the bottom no matter what's sorted.
  function initClientsTable() {
    const table = document.querySelector<HTMLTableElement>("#clients-table");
    if (!table || table.dataset.init) return;
    table.dataset.init = "1";

    const tbody = table.querySelector("tbody")!;
    const buttons = Array.from(table.querySelectorAll<HTMLButtonElement>("thead button"));
    let sortCol = "date";
    let sortDir = 1; // 1 asc, -1 desc

    const keyFor = (col: string) => "sort" + col.charAt(0).toUpperCase() + col.slice(1);

    function apply() {
      const key = keyFor(sortCol);
      const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>("tr"));
      rows.sort((a, b) => {
        const pastDiff = (a.dataset.past === "1" ? 1 : 0) - (b.dataset.past === "1" ? 1 : 0);
        if (pastDiff) return pastDiff;
        const av = a.dataset[key] ?? "";
        const bv = b.dataset[key] ?? "";
        const an = parseFloat(av);
        const bn = parseFloat(bv);
        const numeric = !Number.isNaN(an) && !Number.isNaN(bn);
        const cmp = numeric ? an - bn : String(av).localeCompare(String(bv));
        return cmp * sortDir;
      });
      rows.forEach((row) => tbody.appendChild(row));

      buttons.forEach((btn) => {
        const active = btn.dataset.col === sortCol;
        btn.dataset.active = active ? "1" : "0";
        btn.dataset.dir = active ? (sortDir === 1 ? "asc" : "desc") : "";
        btn.closest("th")?.setAttribute(
          "aria-sort",
          active ? (sortDir === 1 ? "ascending" : "descending") : "none",
        );
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const col = btn.dataset.col!;
        if (col === sortCol) sortDir *= -1;
        else {
          sortCol = col;
          sortDir = 1;
        }
        apply();
      });
    });

    apply();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initClientsTable, { once: true });
  } else {
    initClientsTable();
  }
  document.addEventListener("astro:page-load", initClientsTable);
</script>
