---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { requireAdmin } from "../../lib/auth";
import { supabaseAdmin } from "../../lib/supabase/admin";
import { CATEGORY_LABELS, type BookingCategory } from "../../lib/pricing";

const auth = await requireAdmin(Astro);
if (auth instanceof Response) return auth;

// The Clients view is a table with one row per shoot (booking) — every
// request ever made, newest-relevant first, with the contract and any
// invoices that were tied to that specific shoot pulled in alongside.
const { data: shoots } = await supabaseAdmin
  .from("bookings")
  .select(
    "*, profiles(email, full_name), contracts(id, title, status, signing_url, signed_pdf_url), invoices(id, status, amount_cents, hosted_invoice_url)",
  )
  .order("starts_at", { ascending: true });

const { data: invoices } = await supabaseAdmin
  .from("invoices")
  .select("*, profiles(email, full_name)")
  .order("created_at", { ascending: false });

const { data: contracts } = await supabaseAdmin
  .from("contracts")
  .select("*, profiles(email, full_name)")
  .order("created_at", { ascending: false });

const { data: bookings } = await supabaseAdmin
  .from("bookings")
  .select("*, profiles(email, full_name)")
  .order("starts_at", { ascending: true });

const invoiced = Astro.url.searchParams.get("invoiced");
const emailed = Astro.url.searchParams.get("emailed") !== "0";
const invoiceUrl = Astro.url.searchParams.get("url");
const contracted = Astro.url.searchParams.get("contracted");
const approved = Astro.url.searchParams.get("approved");
const declined = Astro.url.searchParams.get("declined");
const cancelled = Astro.url.searchParams.get("cancelled");
const bookingError = Astro.url.searchParams.get("error");
const bookingErrorMessage =
  bookingError === "slot_conflict"
    ? "That time is no longer free on your calendar — decline this request instead."
    : bookingError === "approve_failed" || bookingError === "decline_failed" || bookingError === "cancel_failed"
      ? "Something went wrong with that booking action. Please try again."
      : null;

function formatAmount(cents: number) {
  return (cents / 100).toLocaleString("en-US", { style: "currency", currency: "USD" });
}

function formatSession(startsAt: string, endsAt: string) {
  const start = new Date(startsAt);
  const end = new Date(endsAt);
  const dateLabel = start.toLocaleDateString(undefined, { weekday: "short", month: "short", day: "numeric" });
  const startLabel = start.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" });
  const endLabel = end.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" });
  return `${dateLabel}, ${startLabel}–${endLabel}`;
}

// ── Build one view-model per shoot for the Clients table ────────────────
const DAY_MS = 86_400_000;
const nowMs = Date.now();
const OPEN_INVOICE = (s: string) => s !== "paid" && s !== "void";

type ContractState = "none" | "signed" | "due" | "overdue";
type PaymentState = "none" | "paid" | "owes";

const shootRows = (shoots ?? []).map((b: any) => {
  const start = new Date(b.starts_at);
  const startMs = start.getTime();
  // A shoot counts as "past" once its start time is behind us — the row
  // sinks to the bottom of the table in lighter gray regardless of sort.
  const isPast = startMs < nowMs;
  const daysSinceShoot = Math.max(1, Math.floor((nowMs - startMs) / DAY_MS));

  const contract = (b.contracts ?? [])[0] ?? null;
  let contractState: ContractState = "none";
  let contractOverdueDays = 0;
  if (contract) {
    if (contract.status === "signed" || contract.status === "voided") {
      contractState = contract.status === "signed" ? "signed" : "none";
    } else if (isPast) {
      contractState = "overdue";
      contractOverdueDays = daysSinceShoot;
    } else {
      contractState = "due";
    }
  }
  const contractHref: string | null =
    contract?.signed_pdf_url || contract?.signing_url || null;

  const invoicesForShoot = (b.invoices ?? []) as Array<{
    status: string;
    amount_cents: number;
    hosted_invoice_url: string | null;
  }>;
  const owedCents = invoicesForShoot
    .filter((i) => OPEN_INVOICE(i.status))
    .reduce((sum, i) => sum + (i.amount_cents ?? 0), 0);
  const paidCents = invoicesForShoot
    .filter((i) => i.status === "paid")
    .reduce((sum, i) => sum + (i.amount_cents ?? 0), 0);
  const payHref =
    invoicesForShoot.find((i) => OPEN_INVOICE(i.status))?.hosted_invoice_url ?? null;
  const paymentState: PaymentState = !invoicesForShoot.length
    ? "none"
    : owedCents > 0
      ? "owes"
      : "paid";

  // Sort keys (ascending puts the most-urgent / earliest first).
  const contractSort =
    contractState === "overdue"
      ? -contractOverdueDays // more overdue → more negative → sorts first
      : contractState === "due"
        ? 1_000_000
        : contractState === "signed"
          ? 2_000_000
          : 3_000_000;
  const paymentSort =
    paymentState === "owes" ? -owedCents : paymentState === "paid" ? 1 : 2;

  const clientName: string = b.profiles?.full_name || b.profiles?.email || "—";
  const email: string = b.profiles?.email || "—";

  return {
    id: b.id,
    status: b.status as string,
    start,
    startMs,
    isPast,
    clientName,
    email,
    contract,
    contractState,
    contractOverdueDays,
    contractHref,
    owedCents,
    paidCents,
    payHref,
    paymentState,
    contractSort,
    paymentSort,
  };
});

// Default order: upcoming shoots first (soonest at top), then past shoots.
shootRows.sort(
  (a, b) => Number(a.isPast) - Number(b.isPast) || a.startMs - b.startMs,
);

function money(cents: number) {
  return (cents / 100).toLocaleString("en-US", { style: "currency", currency: "USD" });
}
---

<BaseLayout title="Admin — Owen McCullum" description="Owen's client portal admin dashboard.">
  <Header />
  <main class="wrap page">
    <header class="page-head reveal portal-head">
      <div>
        <p class="page-eyebrow">Admin</p>
        <h1 class="page-title">Clients</h1>
        <p class="page-lede">
          Everyone who has logged into the portal, plus every invoice,
          contract, and booking request sent so far.
        </p>
      </div>
      <form method="POST" action="/api/auth/signout" class="portal-signout">
        <input type="hidden" name="redirectTo" value="/admin/login" />
        <button type="submit" class="inq-note portal-signout-btn">Sign out</button>
      </form>
    </header>

    <p class="inq-note reveal" style="margin-bottom: 40px;">
      <a href="/portal">← Back to your own portal</a> · <a href="/admin/invoices/new">+ New invoice</a> ·{" "}
      <a href="/admin/contracts/new">+ New contract</a> · <a href="/admin/availability">Manage availability</a>
    </p>

    {invoiced && emailed && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Invoice created and emailed to the client.
      </p>
    )}
    {invoiced && !emailed && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Invoice created, but Stripe couldn't auto-email it yet (your Stripe account needs a bit more setup
        first — see Stripe's dashboard for what it's asking for). Share this link with the client yourself for now:{" "}
        <a href={invoiceUrl ?? "#"} target="_blank" rel="noopener">
          {invoiceUrl}
        </a>
      </p>
    )}
    {contracted && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Contract created and sent to the client for signature.
      </p>
    )}
    {approved && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Booking approved and added to your calendar.
      </p>
    )}
    {declined && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Booking request declined.
      </p>
    )}
    {cancelled && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Booking cancelled.
      </p>
    )}
    {bookingErrorMessage && (
      <p class="inq-feedback inq-error reveal" role="alert" style="margin-bottom: 40px;">
        {bookingErrorMessage}
      </p>
    )}

    {!shootRows.length ? (
      <p class="reveal">No shoots booked yet.</p>
    ) : (
      <div class="at-wrap reveal">
        <table class="admin-table" id="clients-table">
          <thead>
            <tr>
              <th aria-sort="ascending">
                <button type="button" data-col="date" data-active="1" data-dir="asc">Date of session</button>
              </th>
              <th aria-sort="none"><button type="button" data-col="client">Client</button></th>
              <th aria-sort="none"><button type="button" data-col="email">Email</button></th>
              <th aria-sort="none"><button type="button" data-col="contract">Contract</button></th>
              <th aria-sort="none"><button type="button" data-col="payment">Payment</button></th>
            </tr>
          </thead>
          <tbody>
            {shootRows.map((r) => (
              <tr
                class={r.isPast ? "is-past" : undefined}
                data-past={r.isPast ? "1" : "0"}
                data-sort-date={String(r.startMs)}
                data-sort-client={r.clientName.toLowerCase()}
                data-sort-email={r.email.toLowerCase()}
                data-sort-contract={String(r.contractSort)}
                data-sort-payment={String(r.paymentSort)}
              >
                <td>
                  {r.start.toLocaleDateString(undefined, {
                    weekday: "short",
                    month: "short",
                    day: "numeric",
                    year: "numeric",
                  })}
                  <span class="at-sub">
                    {r.start.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" })}
                    {r.status !== "confirmed" && <> · {r.status}</>}
                  </span>
                </td>
                <td class="at-client">{r.clientName}</td>
                <td>
                  <a href={`mailto:${r.email}`}>{r.email}</a>
                </td>
                <td>
                  {r.contractState === "none" ? (
                    <span class="at-none">None</span>
                  ) : (
                    <>
                      {r.contractHref ? (
                        <a href={r.contractHref} target="_blank" rel="noopener">
                          {r.contract?.title || "Contract"}
                        </a>
                      ) : (
                        <span>{r.contract?.title || "Contract"}</span>
                      )}
                      <span class={`at-sub${r.contractState === "overdue" ? " at-overdue" : ""}`}>
                        {r.contractState === "signed" && "Signed"}
                        {r.contractState === "due" && "Awaiting signature"}
                        {r.contractState === "overdue" &&
                          `Overdue by ${r.contractOverdueDays} day${r.contractOverdueDays === 1 ? "" : "s"}`}
                      </span>
                    </>
                  )}
                </td>
                <td>
                  {r.paymentState === "none" ? (
                    <span class="at-none">No invoice</span>
                  ) : r.paymentState === "paid" ? (
                    <>
                      Paid<span class="at-sub">{money(r.paidCents)}</span>
                    </>
                  ) : r.payHref ? (
                    <a href={r.payHref} target="_blank" rel="noopener">
                      Owes {money(r.owedCents)}
                    </a>
                  ) : (
                    <>Owes {money(r.owedCents)}</>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <h2 class="page-title reveal" style="font-size: clamp(24px, 3vw, 36px); margin-top: 72px;">Invoices</h2>

    {!invoices?.length ? (
      <p class="reveal">No invoices sent yet.</p>
    ) : (
      <div class="contact-grid reveal">
        {invoices.map((invoice) => (
          <div class="contact-block">
            <p class="ck">
              {invoice.status} · {new Date(invoice.created_at).toLocaleDateString()}
            </p>
            <p class="big">{formatAmount(invoice.amount_cents)}</p>
            <p>
              {invoice.description}
              <br />
              {invoice.profiles?.full_name || invoice.profiles?.email}
            </p>
          </div>
        ))}
      </div>
    )}

    <h2 class="page-title reveal" style="font-size: clamp(24px, 3vw, 36px); margin-top: 72px;">Contracts</h2>

    {!contracts?.length ? (
      <p class="reveal">No contracts sent yet.</p>
    ) : (
      <div class="contact-grid reveal">
        {contracts.map((contract) => (
          <div class="contact-block">
            <p class="ck">
              {contract.status} · {new Date(contract.created_at).toLocaleDateString()}
            </p>
            <p class="big">{contract.title}</p>
            <p>{contract.profiles?.full_name || contract.profiles?.email}</p>
          </div>
        ))}
      </div>
    )}

    <h2 class="page-title reveal" style="font-size: clamp(24px, 3vw, 36px); margin-top: 72px;">Bookings</h2>

    {!bookings?.length ? (
      <p class="reveal">No booking requests yet.</p>
    ) : (
      <div class="contact-grid reveal">
        {bookings.map((booking) => (
          <div class="contact-block">
            <p class="ck">
              {booking.status} · {formatSession(booking.starts_at, booking.ends_at)}
            </p>
            <p class="big">{booking.profiles?.full_name || booking.profiles?.email}</p>
            {booking.category && booking.hours && booking.estimated_price_cents != null && (
              <p class="inq-note">
                Estimate: {CATEGORY_LABELS[booking.category as BookingCategory] ?? booking.category} · {booking.hours}{" "}
                hour{booking.hours === 1 ? "" : "s"} · {formatAmount(booking.estimated_price_cents)}
              </p>
            )}
            {booking.note && <p>{booking.note}</p>}
            {booking.status === "pending" && (
              <p class="inq-note" style="margin-top: 10px;">
                <form method="POST" action="/api/admin/bookings/approve" style="display:inline;">
                  <input type="hidden" name="bookingId" value={booking.id} />
                  <button type="submit" class="portal-signout-btn">Approve</button>
                </form>
                {" · "}
                <form method="POST" action="/api/admin/bookings/decline" style="display:inline;">
                  <input type="hidden" name="bookingId" value={booking.id} />
                  <button type="submit" class="portal-signout-btn">Decline</button>
                </form>
              </p>
            )}
            {booking.status === "confirmed" && (
              <p class="inq-note" style="margin-top: 10px;">
                <form method="POST" action="/api/admin/bookings/cancel" style="display:inline;">
                  <input type="hidden" name="bookingId" value={booking.id} />
                  <button type="submit" class="portal-signout-btn">Cancel</button>
                </form>
              </p>
            )}
          </div>
        ))}
      </div>
    )}
  </main>
  <Footer />
</BaseLayout>

<script>
  // Click any column header to sort the shoots table by that column; click
  // the active one again to flip direction. Past shoots always stay grouped
  // at the bottom no matter what's sorted.
  function initClientsTable() {
    const table = document.querySelector<HTMLTableElement>("#clients-table");
    if (!table || table.dataset.init) return;
    table.dataset.init = "1";

    const tbody = table.querySelector("tbody")!;
    const buttons = Array.from(table.querySelectorAll<HTMLButtonElement>("thead button"));
    let sortCol = "date";
    let sortDir = 1; // 1 asc, -1 desc

    const keyFor = (col: string) => "sort" + col.charAt(0).toUpperCase() + col.slice(1);

    function apply() {
      const key = keyFor(sortCol);
      const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>("tr"));
      rows.sort((a, b) => {
        const pastDiff = (a.dataset.past === "1" ? 1 : 0) - (b.dataset.past === "1" ? 1 : 0);
        if (pastDiff) return pastDiff;
        const av = a.dataset[key] ?? "";
        const bv = b.dataset[key] ?? "";
        const an = parseFloat(av);
        const bn = parseFloat(bv);
        const numeric = !Number.isNaN(an) && !Number.isNaN(bn);
        const cmp = numeric ? an - bn : String(av).localeCompare(String(bv));
        return cmp * sortDir;
      });
      rows.forEach((row) => tbody.appendChild(row));

      buttons.forEach((btn) => {
        const active = btn.dataset.col === sortCol;
        btn.dataset.active = active ? "1" : "0";
        btn.dataset.dir = active ? (sortDir === 1 ? "asc" : "desc") : "";
        btn.closest("th")?.setAttribute(
          "aria-sort",
          active ? (sortDir === 1 ? "ascending" : "descending") : "none",
        );
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const col = btn.dataset.col!;
        if (col === sortCol) sortDir *= -1;
        else {
          sortCol = col;
          sortDir = 1;
        }
        apply();
      });
    });

    apply();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initClientsTable, { once: true });
  } else {
    initClientsTable();
  }
  document.addEventListener("astro:page-load", initClientsTable);
</script>
