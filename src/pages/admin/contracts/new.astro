---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { requireAdmin } from "../../../lib/auth";
import { supabaseAdmin } from "../../../lib/supabase/admin";

const auth = await requireAdmin(Astro);
if (auth instanceof Response) return auth;

// Optionally tie this contract to a specific shoot, so the admin Clients
// table can show its signed / due / overdue status on that shoot's row.
const { data: shootOptions } = await supabaseAdmin
  .from("bookings")
  .select("id, starts_at, status, profiles(email, full_name)")
  .order("starts_at", { ascending: false });

function shootLabel(b: any) {
  const when = new Date(b.starts_at).toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" });
  const who = b.profiles?.full_name || b.profiles?.email || "unknown client";
  return `${when} — ${who}${b.status !== "confirmed" ? ` (${b.status})` : ""}`;
}

// Arriving from a client's own page (?email=&clientName=) prefills who
// it's for, same idea as picking a shoot below.
const prefillEmail = Astro.url.searchParams.get("email") ?? "";
const prefillName = Astro.url.searchParams.get("clientName") ?? "";

const error = Astro.url.searchParams.get("error");
const errorMessage =
  error === "create_failed"
    ? "Something went wrong creating that contract. Please try again."
    : error === "not_configured"
      ? "The contract template isn't set up yet — add DOCUMENSO_TEMPLATE_ID to the environment first."
      : null;
---

<BaseLayout title="New Contract — Owen McCullum" description="Send a new contract to a client for signature.">
  <Header />
  <main class="wrap page">
    <header class="page-head reveal">
      <p class="page-eyebrow">Admin</p>
      <h1 class="page-title">New contract.</h1>
      <p class="page-lede">
        Enter the client's details — if they've never logged into the portal before, an account is created for them
        automatically. They'll get a real e-signature request with these fields already filled in; anything not
        listed here (additional details, minors, etc.) they'll fill in themselves when they sign.
      </p>
    </header>

    <p class="inq-note reveal" style="margin-bottom: 40px;"><a href="/admin">← Back to admin</a></p>

    <form class="inquire reveal" method="POST" action="/api/admin/contracts/create" novalidate>
      <p class="inq-eyebrow">Contract details</p>

      <div class="inq-field">
        <label for="ct-title">Title (for your own records)</label>
        <input id="ct-title" name="title" type="text" placeholder="e.g. Fall Portrait Session Agreement" required />
      </div>

      {shootOptions && shootOptions.length > 0 && (
        <div class="inq-field">
          <label for="ct-shoot">Shoot this contract is for (optional)</label>
          <select id="ct-shoot" name="bookingId">
            <option value="">— Not tied to a specific shoot —</option>
            {shootOptions.map((b) => (
              <option
                value={b.id}
                data-email={b.profiles?.email ?? ""}
                data-name={b.profiles?.full_name ?? ""}
              >
                {shootLabel(b)}
              </option>
            ))}
          </select>
        </div>
      )}

      <div class="inq-field">
        <label for="ct-email">Client email</label>
        <input id="ct-email" name="email" type="email" autocomplete="off" required value={prefillEmail} />
      </div>

      <div class="inq-field">
        <label for="ct-name">Client name</label>
        <input id="ct-name" name="clientName" type="text" required value={prefillName} />
      </div>

      <div class="inq-field">
        <label for="ct-address">Client address (optional)</label>
        <input id="ct-address" name="address" type="text" />
      </div>

      <div class="inq-field">
        <label for="ct-phone">Client phone (optional)</label>
        <input id="ct-phone" name="phone" type="tel" />
      </div>

      <div class="inq-field">
        <label for="ct-session-date">Date(s) of session</label>
        <input id="ct-session-date" name="sessionDate" type="text" placeholder="e.g. October 12, 2026" required />
      </div>

      <div class="inq-field">
        <label for="ct-time">Start / end time</label>
        <input id="ct-time" name="startEndTime" type="text" placeholder="e.g. 4:00pm – 6:00pm" />
      </div>

      <div class="inq-field">
        <label for="ct-location">Session location(s)</label>
        <input id="ct-location" name="location" type="text" />
      </div>

      <div class="inq-field">
        <label for="ct-fee">Total session fee (USD)</label>
        <input id="ct-fee" name="totalFee" type="number" min="1" step="0.01" placeholder="500.00" required />
        <span class="inq-note" aria-live="polite" id="fee-breakdown" style="min-height: 13px;"></span>
      </div>

      {errorMessage && (
        <p class="inq-feedback inq-error" role="alert">
          {errorMessage}
        </p>
      )}

      <button class="inq-submit" type="submit">Create &amp; send contract</button>
    </form>
  </main>
  <Footer />
</BaseLayout>

<script>
  function initShootLink() {
    const shoot = document.querySelector<HTMLSelectElement>("#ct-shoot");
    const email = document.querySelector<HTMLInputElement>("#ct-email");
    const name = document.querySelector<HTMLInputElement>("#ct-name");
    if (!shoot || !email || shoot.dataset.init) return;
    shoot.dataset.init = "1";

    // Picking a shoot pins the client — fill in and lock their email, and
    // prefill the name if we have one on file (still editable).
    shoot.addEventListener("change", () => {
      const opt = shoot.selectedOptions[0];
      const em = opt?.dataset.email || "";
      if (em) {
        email.value = em;
        email.readOnly = true;
        if (name && opt?.dataset.name) name.value = opt.dataset.name;
      } else {
        email.readOnly = false;
      }
    });
  }

  function initFeeBreakdown() {
    const fee = document.querySelector<HTMLInputElement>("#ct-fee");
    const out = document.querySelector<HTMLElement>("#fee-breakdown");
    if (!fee || !out || fee.dataset.init) return;
    fee.dataset.init = "1";

    const update = () => {
      const total = parseFloat(fee.value);
      if (!(total > 0)) {
        out.textContent = "";
        return;
      }
      const retainer = (total * 0.2).toFixed(2);
      const balance = (total * 0.8).toFixed(2);
      out.textContent = `Retainer (20%): $${retainer} · Balance (80%): $${balance}`;
    };
    fee.addEventListener("input", update);
    update();
  }

  function init() {
    initShootLink();
    initFeeBreakdown();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
  document.addEventListener("astro:page-load", init);
</script>
