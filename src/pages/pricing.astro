---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "Pricing — Owen McCullum";
const description =
  "Book a documentary or portrait session with Owen McCullum, Washington, D.C. — request an open date and time, and he'll follow up to confirm details and pricing.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="wrap page">
    <header class="page-head reveal">
      <p class="page-eyebrow">Pricing</p>
      <h1 class="page-title">Plan your shoot.</h1>
      <p class="page-lede">
        Pick an open date and time and send a request — Owen will follow up
        to confirm the details and pricing for your session. For archival
        prints and image licensing, see <a href="/prints">Prints</a>.
      </p>
    </header>

    <div class="contact-block reveal" style="max-width: 420px;">
      <p class="ck">Sessions</p>
      <a class="big" href="/book">Check availability &amp; request a date →</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
