---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { requireUser } from "../../lib/auth";
import { getBusinessTimezone, inTz } from "../../lib/businessTime";
import { CATEGORY_LABELS, type BookingCategory } from "../../lib/pricing";

const auth = await requireUser(Astro);
if (auth instanceof Response) return auth;
const { supabase, user, profile } = auth;

const displayName = profile.full_name || user.email;

// RLS already limits this to the logged-in client's own rows.
const { data: invoices } = await supabase
  .from("invoices")
  .select("*")
  .order("created_at", { ascending: false });

const { data: contracts } = await supabase
  .from("contracts")
  .select("*")
  .order("created_at", { ascending: false });

const { data: bookings } = await supabase.from("bookings").select("*").order("starts_at", { ascending: true });

function formatAmount(cents: number) {
  return (cents / 100).toLocaleString("en-US", { style: "currency", currency: "USD" });
}

const tz = await getBusinessTimezone();

function formatSession(startsAt: string, endsAt: string) {
  return `${inTz(startsAt, tz, "EEEE, MMMM d")}, ${inTz(startsAt, tz, "h:mm a")}–${inTz(endsAt, tz, "h:mm a")}`;
}

/** "In review" → "Booked" → "Completed" (or Declined / Cancelled). */
function sessionStatus(b: { status: string; ends_at: string }): string {
  if (b.status === "pending") return "In review";
  if (b.status === "confirmed") return new Date(b.ends_at).getTime() < Date.now() ? "Completed" : "Booked";
  if (b.status === "declined") return "Declined";
  if (b.status === "cancelled") return "Cancelled";
  return b.status;
}
const BOOKING_STATUS_LABEL = { pending: "In review", confirmed: "Booked", declined: "Declined", cancelled: "Cancelled" } as Record<
  string,
  string
>;

function invoiceStatus(status: string): { label: string; done: boolean } {
  if (status === "paid") return { label: "Paid", done: true };
  if (status === "void") return { label: "Cancelled", done: false };
  return { label: "Payment due", done: false };
}

/** "Needs signing" → "Awaiting Owen's signature" → "Signed" (done, nothing left for the client). */
function contractStatus(c: { status: string; countersigned_at: string | null }): { label: string; done: boolean } {
  if (c.status === "sent") return { label: "Needs signing", done: false };
  if (c.status === "signed") {
    return c.countersigned_at ? { label: "Signed", done: true } : { label: "Awaiting Owen's signature", done: false };
  }
  if (c.status === "voided") return { label: "Cancelled", done: false };
  return { label: c.status, done: false };
}

const cancelled = Astro.url.searchParams.get("cancelled");
const cancelFailed = Astro.url.searchParams.get("error") === "cancel_failed";

// "At a glance" — the one thing in each category that actually needs the
// client's attention right now, surfaced above the full history below.
const now = Date.now();
const nextSession =
  bookings
    ?.filter((b) => (b.status === "pending" || b.status === "confirmed") && new Date(b.starts_at).getTime() >= now)
    .sort((a, b) => new Date(a.starts_at).getTime() - new Date(b.starts_at).getTime())[0] ?? null;

const outstandingInvoice =
  invoices
    ?.filter((i) => i.status === "sent")
    .sort((a, b) => {
      if (a.due_date && b.due_date) return a.due_date.localeCompare(b.due_date);
      if (a.due_date) return -1;
      if (b.due_date) return 1;
      return new Date(a.created_at).getTime() - new Date(b.created_at).getTime();
    })[0] ?? null;

const pendingContract =
  contracts
    ?.filter((c) => c.status === "sent")
    .sort((a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime())[0] ?? null;

const hasGlanceItem = !!(nextSession || outstandingInvoice || pendingContract);
---

<BaseLayout title="Your Portal — Owen McCullum" description="Your client portal — invoices, contracts, and scheduling.">
  <Header />
  <main class="wrap page">
    <header class="page-head reveal portal-head">
      <div>
        <p class="page-eyebrow">Client Portal</p>
        <h1 class="page-title">Welcome, {displayName}.</h1>
        <p class="page-lede">
          Invoices, contracts, and session scheduling will show up here as
          Owen sends them your way.
        </p>
      </div>
      <form method="POST" action="/api/auth/signout" class="portal-signout">
        <button type="submit" class="inq-note portal-signout-btn">Sign out</button>
      </form>
    </header>

    {cancelled && (
      <p class="inq-feedback reveal" role="status" style="margin-bottom: 40px;">
        Booking cancelled.
      </p>
    )}
    {cancelFailed && (
      <p class="inq-feedback inq-error reveal" role="alert" style="margin-bottom: 40px;">
        Couldn't cancel that booking — please try again.
      </p>
    )}

    {profile.is_admin && (
      <p class="inq-note reveal" style="margin-bottom: 40px;">
        You're an admin. <a href="/admin">Go to the admin dashboard →</a>
      </p>
    )}

    <div class="dash-grid reveal">
      {!hasGlanceItem ? (
        <div class="dash-card dash-card-wide">
          <p class="dash-note">You're all caught up — nothing needs your attention right now.</p>
        </div>
      ) : (
        <>
          <div class="dash-card">
            <p class="ck">Next Session</p>
            {nextSession ? (
              <>
                <p class="dash-value">{formatSession(nextSession.starts_at, nextSession.ends_at)}</p>
                <p class="dash-note">{BOOKING_STATUS_LABEL[nextSession.status] ?? nextSession.status}</p>
              </>
            ) : (
              <p class="dash-note">Nothing booked yet. <a href="/book">Book a session →</a></p>
            )}
          </div>
          <div class="dash-card">
            <p class="ck">Payment Due</p>
            {outstandingInvoice ? (
              <>
                <p class="dash-value">{formatAmount(outstandingInvoice.amount_cents)}</p>
                <p class="dash-note">
                  {outstandingInvoice.description}
                  {outstandingInvoice.hosted_invoice_url && (
                    <>
                      {" "}
                      <a href={outstandingInvoice.hosted_invoice_url} target="_blank" rel="noopener">
                        Pay now →
                      </a>
                    </>
                  )}
                </p>
              </>
            ) : (
              <p class="dash-note">Nothing outstanding.</p>
            )}
          </div>
          <div class="dash-card">
            <p class="ck">Contract to Sign</p>
            {pendingContract ? (
              <>
                <p class="dash-value">{pendingContract.title}</p>
                <p class="dash-note">
                  {pendingContract.signing_url && (
                    <a href={pendingContract.signing_url} target="_blank" rel="noopener">
                      Review &amp; sign →
                    </a>
                  )}
                </p>
              </>
            ) : (
              <p class="dash-note">Nothing pending.</p>
            )}
          </div>
        </>
      )}
    </div>

    <section class="portal-section reveal">
      <h2 class="portal-h">Sessions</h2>
      {!bookings?.length ? (
        <p class="portal-empty">Nothing booked yet.</p>
      ) : (
        <div class="at-wrap">
          <table class="admin-table portal-table">
            <thead>
              <tr>
                <th>Session</th>
                <th>Details</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {bookings.map((booking) => {
                const label = CATEGORY_LABELS[booking.category as BookingCategory];
                const status = sessionStatus(booking);
                const canCancel =
                  (booking.status === "pending" || booking.status === "confirmed") &&
                  new Date(booking.ends_at).getTime() >= now;
                return (
                  <tr>
                    <td>{formatSession(booking.starts_at, booking.ends_at)}</td>
                    <td>
                      {label ?? "Session"}
                      {booking.hours && (
                        <span class="at-sub">
                          {booking.hours} hour{booking.hours === 1 ? "" : "s"}
                          {booking.estimated_price_cents != null && <> · est. {formatAmount(booking.estimated_price_cents)}</>}
                          {booking.category === "printing" && <> + materials</>}
                        </span>
                      )}
                      {booking.note && <span class="at-sub portal-note">{booking.note}</span>}
                    </td>
                    <td>
                      <span class={`status-pill${status === "Booked" || status === "Completed" ? " is-done" : ""}`}>{status}</span>
                    </td>
                    <td class="portal-actions">
                      {canCancel && (
                        <form
                          method="POST"
                          action="/api/bookings/cancel"
                          style="display:inline;"
                          onsubmit="return confirm('Are you sure you want to cancel? Any fees paid at this time are non-refundable.');"
                        >
                          <input type="hidden" name="bookingId" value={booking.id} />
                          <button type="submit" class="portal-signout-btn">Cancel</button>
                        </form>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
      <p class="inq-note" style="margin-top: 14px;"><a href="/book">Book another session →</a></p>
    </section>

    <section class="portal-section reveal">
      <h2 class="portal-h">Invoices</h2>
      {!invoices?.length ? (
        <p class="portal-empty">Nothing yet — invoices Owen sends you will show up here.</p>
      ) : (
        <div class="at-wrap">
          <table class="admin-table portal-table">
            <thead>
              <tr>
                <th>Invoice</th>
                <th>Amount</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {invoices.map((invoice) => {
                const st = invoiceStatus(invoice.status);
                return (
                  <tr class={invoice.status === "void" ? "is-void" : undefined}>
                    <td>
                      {invoice.description}
                      {invoice.due_date && invoice.status === "sent" && (
                        <span class="at-sub">Due {inTz(`${invoice.due_date}T12:00:00Z`, "UTC", "MMM d, yyyy")}</span>
                      )}
                    </td>
                    <td>{formatAmount(invoice.amount_cents)}</td>
                    <td>
                      <span class={`status-pill${st.done ? " is-done" : ""}`}>
                        {st.done && <span aria-hidden="true">✓ </span>}
                        {st.label}
                      </span>
                    </td>
                    <td class="portal-actions">
                      {invoice.status === "sent" && invoice.hosted_invoice_url && (
                        <a class="portal-signout-btn" href={invoice.hosted_invoice_url} target="_blank" rel="noopener">
                          Pay now
                        </a>
                      )}
                      {invoice.status === "paid" && invoice.hosted_invoice_url && (
                        <a class="portal-signout-btn" href={invoice.hosted_invoice_url} target="_blank" rel="noopener">
                          View receipt
                        </a>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <section class="portal-section reveal">
      <h2 class="portal-h">Contracts</h2>
      {!contracts?.length ? (
        <p class="portal-empty">Nothing yet — contracts to review and sign will show up here.</p>
      ) : (
        <div class="at-wrap">
          <table class="admin-table portal-table">
            <thead>
              <tr>
                <th>Contract</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {contracts.map((contract) => {
                const st = contractStatus(contract);
                const copyUrl = contract.countersigned_pdf_url || contract.signed_pdf_url;
                return (
                  <tr class={contract.status === "voided" ? "is-void" : undefined}>
                    <td>{contract.title}</td>
                    <td>
                      <span class={`status-pill${st.done ? " is-done" : ""}`}>
                        {st.done && <span aria-hidden="true">✓ </span>}
                        {st.label}
                      </span>
                      {st.done && <span class="at-sub">Nothing more needed from you</span>}
                    </td>
                    <td class="portal-actions">
                      {contract.status === "sent" && contract.signing_url && (
                        <a class="portal-signout-btn" href={contract.signing_url} target="_blank" rel="noopener">
                          Review &amp; sign
                        </a>
                      )}
                      {contract.status === "signed" && copyUrl && (
                        <a class="portal-signout-btn" href={copyUrl} target="_blank" rel="noopener">
                          View signed copy
                        </a>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .portal-section {
    margin-bottom: 56px;
  }
  .portal-h {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mute);
    margin: 0 0 16px;
  }
  .portal-empty {
    margin: 0;
    color: var(--mute);
  }
  .portal-table th {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
  }
  /* The shared admin table keeps cells on one line; client-facing text
     (long invoice descriptions, notes) needs to wrap. */
  .portal-table th,
  .portal-table td {
    white-space: normal;
  }
  .portal-table tr.is-void td {
    color: var(--mute);
    text-decoration: line-through;
  }
  .portal-table .portal-note {
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--sans);
    font-size: 13px;
  }
  .portal-actions {
    text-align: right;
    white-space: nowrap;
  }
  .status-pill {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    white-space: nowrap;
  }
  .status-pill.is-done {
    border-color: #2f7d4f;
    color: #2f7d4f;
  }
</style>
